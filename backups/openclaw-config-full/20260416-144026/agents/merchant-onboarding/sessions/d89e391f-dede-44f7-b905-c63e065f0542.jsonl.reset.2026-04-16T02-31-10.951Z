{"type":"message","id":"b2b9aae6","parentId":"21e9ea1f","timestamp":"2026-04-16T02:02:27.307Z","message":{"role":"toolResult","toolCallId":"call_ymHzecNH797hqzoIrRIZxT5J|fc_087388a10928779c0169e04332a3b08191a8db5d9dc09e4bc3","toolName":"read","content":[{"type":"text","text":"#!/usr/bin/env python3\n\"\"\"step3of5-settlement runner\n唯一入口: python3 runner.py run_all\n\n填写 \"商户入网 - 结算信息 (3/5 步)\" 页面的两个滚轮字段:\n- 结算方式 (1 列滚轮 picker)   目标: 对公清算   (用户语义 \"对公结算\")\n- 结算周期 (1 列滚轮 picker)   目标: 自动结算(T1)  (用户语义 \"T1\")\n\n前置: 设备已经停留在结算信息表单页 (本 skill 不负责导航到该页).\n\n两个 picker 复用同一套 wheel 逻辑, 差异通过 PICKERS config 表达.\n本地 UI parser + PaddleOCR 负责所有结构判定 / 文字识别, Claude 只读 runner 单行 JSON 结果.\n\"\"\"\n\nimport sys\nimport json\nimport time\nimport subprocess\nimport argparse\nimport difflib\nimport re\nimport os\nimport xml.etree.ElementTree as ET\nfrom pathlib import Path\n\n# ==================== 硬编码常量 ====================\n\nADB    = \"/opt/homebrew/Caskroom/android-platform-tools/36.0.2/platform-tools/adb\"\nDEVICE = \"GAUOMVKR79ZPYPVK\"\nPKG    = \"com.fuiou.pay.fybussess\"\n\n# ---------- 表单页特征 ----------\nFORM_TITLE_TEXT = \"商户入网\"     # titleBarTitle.text\nFORM_STEP_TEXT  = \"结算信息\"     # nameTv.text (第 3 步)\nFORM_STEP_NUM   = \"3\"            # progressTv.text, 当前选中 (h 最大)\n\n# ---------- 目标值 (UI 真实文本, 非用户口头语义) ----------\n# 用户语义 -> UI 实际文本映射:\n#   \"对公结算\" -> \"对公清算\"\n#   \"T1\"       -> \"自动结算(T1)\"\nMETHOD_TARGET = \"对公清算\"\nCYCLE_TARGET  = \"自动结算(T1)\"\n\n# ---------- 对公户开户凭证上传 ----------\nPUBLIC_ACCOUNT_VOUCHER_JPG = \"/Users/chongya/Desktop/入网资料/对公账户.jpg\"\nCONTACT_INFO_MD = \"/Users/chongya/Desktop/入网资料/地址、联系人、电话.md\"\nREMOTE_DIR = \"/sdcard/DCIM/Camera\"\n\n# ---------- 表单字段 ----------\n# label 是 titleNameTv.text, 用于定位同行的 contentEt.text 做回写校验.\n# tap_xy 取自 contentEt bounds 中心.\nFORM_FIELDS = {\n    \"method\": {\n        \"tap_xy\": (577, 555),\n        \"opens\": \"method_picker\",\n        \"label\": \"结算方式\",\n        \"placeholder\": \"请选择结算方式\",\n        \"target\": METHOD_TARGET,\n    },\n    \"cycle\": {\n        \"tap_xy\": (577, 704),\n        \"opens\": \"cycle_picker\",\n        \"label\": \"结算周期\",\n        \"placeholder\": \"请选择结算周期\",\n        \"target\": CYCLE_TARGET,\n    },\n}\n\n# ---------- Picker 配置表 ----------\n# 结算信息页的两个 picker 结构完全一致 (单列 optionspicker):\n#   titleBar: pickerTitleTv [161,1738][919,1850]\n#   cancel:   iv_cancel     [0,1738][161,1850]   -> (80, 1794)\n#   confirm:  tv_finish     [919,1759][1080,1828] -> (999, 1793)\n#   options:  optionspicker [26,1850][1054,2181]  (容器截断, 实际可视项超出)\n# OCR ROI 上界扩到 2340 (覆盖最下一项, 避开 y>2350 系统导航栏).\n_PICKER_COMMON = {\n    \"title_rid_suffixes\": [\"pickerTitleTv\"],\n    \"confirm_xy\": (999, 1793),\n    \"cancel_xy\":  (80,  1794),\n    \"columns\": [\n        {\"name\": \"v\", \"bounds\": (0, 1850, 1080, 2340), \"x\": 540},\n    ],\n    \"blind_step_px\": 450,   # 项间距 ~150px, 一次 ~3 项\n}\n\n_CITY_PICKER = {\n    \"title_rid_suffixes\": [\"pickTitleTv\"],\n    \"confirm_xy\": (999, 1323),\n    \"cancel_xy\":  (80, 1324),\n    \"columns\": [\n        {\"name\": \"prov\", \"bounds\": (0, 1380, 540, 2420), \"x\": 250},\n        {\"name\": \"city\", \"bounds\": (540, 1380, 1080, 2420), \"x\": 810},\n    ],\n    \"blind_step_px\": 450,\n}\n\nPICKERS = {\n    \"method_picker\": {**_PICKER_COMMON, \"title\": \"结算方式\"},\n    \"cycle_picker\":  {**_PICKER_COMMON, \"title\": \"结算周期\"},\n    \"bank_picker\":   {**_PICKER_COMMON, \"title\": \"开户银行\"},\n    \"city_picker\":   {**_CITY_PICKER, \"title\": \"开户行省市\"},\n}\n\n# ---------- 其他 ----------\nSWIPE_DUR_MS     = 350\nSETTLE_S         = 0.6\nGALLERY_WAIT_S   = 1.5\nPREVIEW_WAIT_S   = 1.2\nUPLOAD_WAIT_S    = 2.5\nMAX_SCROLL_TRIES = 12\nFUZZY_RATIO      = 0.85\nBRANCH_DROPDOWN_WAIT_S = 1.5    # ADBKeyBoard 注入中文后等下拉 PopupWindow 出现\n\nHERE       = Path(__file__).resolve().parent\nCACHE_DIR  = HERE / \"cache\"\nCACHE_DIR.mkdir(exist_ok=True)\nSCREEN_PNG = CACHE_DIR / \"last_screen.png\"\nUI_XML     = CACHE_DIR / \"last_ui.xml\"\n\n\n# ==================== 结果约定 ====================\n\ndef result_ok(msg, **extra):\n    out = {\"status\": \"OK\", \"msg\": msg}\n    out.update(extra)\n    print(json.dumps(out, ensure_ascii=False))\n    return 0\n\ndef result_need_llm(reason, detail, llm_action):\n    print(json.dumps({\n        \"status\": \"NEED_LLM\",\n        \"reason\": reason,\n        \"detail\": detail,\n        \"llm_action\": llm_action,\n    }, ensure_ascii=False))\n    return 2\n\ndef result_err(msg, **extra):\n    out = {\"status\": \"ERROR\", \"msg\": msg}\n    out.update(extra)\n    print(json.dumps(out, ensure_ascii=False))\n    return 1\n\n\n# ==================== adb 原语 ====================\n\ndef _adb(*args, timeout=30):\n    r = subprocess.run(\n        [ADB, \"-s\", DEVICE] + list(args),\n        capture_output=True, text=True, timeout=timeout,\n    )\n    if r.returncode != 0:\n        raise RuntimeError(f\"adb {' '.join(args)} failed: {r.stderr.strip()}\")\n    return r.stdout\n\ndef adb_shell(*args):\n    return _adb(\"shell\", *args)\n\ndef adb_screencap(dst: Path = SCREEN_PNG):\n    adb_shell(\"screencap\", \"-p\", \"/sdcard/_s.png\")\n    _adb(\"pull\", \"/sdcard/_s.png\", str(dst))\n    return dst\n\ndef adb_swipe(x1, y1, x2, y2, dur=SWIPE_DUR_MS):\n    adb_shell(\"input\", \"swipe\", str(int(x1)), str(int(y1)),\n              str(int(x2)), str(int(y2)), str(dur))\n\ndef adb_tap(x, y):\n    adb_shell(\"input\", \"tap\", str(int(x)), str(int(y)))\n\ndef adb_dump_ui(dst: Path = UI_XML, retries=3):\n    for attempt in range(retries):\n        try:\n            adb_shell(\"uiautomator\", \"dump\", \"/sdcard/_ui.xml\")\n            _adb(\"pull\", \"/sdcard/_ui.xml\", str(dst))\n            return dst\n        except RuntimeError:\n            if attempt == retries - 1:\n                raise\n            time.sleep(0.5)\n\n\n# ==================== UI 解析 ====================\n\n_BOUNDS_RE = re.compile(r\"\\[(\\d+),(\\d+)\\]\\[(\\d+),(\\d+)\\]\")\n\ndef parse_bounds(s):\n    m = _BOUNDS_RE.match(s or \"\")\n    return tuple(map(int, m.groups())) if m else None\n\ndef parse_ui(xml_path: Path):\n    return list(ET.parse(xml_path).iter(\"node\"))\n\ndef _rid_ends_with(node, suffix):\n    rid = node.get(\"resource-id\", \"\")\n    return rid.endswith(\"/\" + suffix) or rid == suffix or rid.endswith(suffix)\n\ndef _node_bounds(node):\n    b = parse_bounds(node.get(\"bounds\", \"\"))\n    if not b:\n        return None\n    if b[2] <= b[0] or b[3] <= b[1]:\n        return None\n    return b\n\ndef _node_center(node):\n    b = _node_bounds(node)\n    if not b:\n        return None\n    return ((b[0] + b[2]) // 2, (b[1] + b[3]) // 2)\n\ndef find_nodes(nodes, rid_suffix=None, text=None, visible_only=True):\n    out = []\n    for n in nodes:\n        if rid_suffix is not None and not _rid_ends_with(n, rid_suffix):\n            continue\n        if text is not None and n.get(\"text\", \"\") != text:\n            continue\n        if visible_only and _node_bounds(n) is None:\n            continue\n        out.append(n)\n    return out\n\ndef find_current_picker(nodes):\n    \"\"\"\n    只查 picker title 控件的 text, 不 grep 整个 xml\n    (避免表单底层 '结算方式' 标签导致误判).\n    返回 (picker_name, title_text) 或 (None, None).\n    \"\"\"\n    for picker_name, cfg in PICKERS.items():\n        for n in nodes:\n            for suffix in cfg[\"title_rid_suffixes\"]:\n                if _rid_ends_with(n, suffix) and n.get(\"text\", \"\") == cfg[\"title\"]:\n                    return picker_name, cfg[\"title\"]\n    return None, None\n\ndef current_step_num(nodes):\n    \"\"\"当前高亮的 progressTv (h 最大) 的 text.\"\"\"\n    ps = []\n    for n in nodes:\n        if _rid_ends_with(n, \"progressTv\"):\n            b = parse_bounds(n.get(\"bounds\", \"\"))\n            if b:\n                ps.append((b[3] - b[1], n.get(\"text\", \"\")))\n    if not ps:\n        return None\n    ps.sort(key=lambda t: -t[0])\n    return ps[0][1]\n\ndef on_form_page(nodes):\n    \"\"\"检测是否在 '商户入网 - 结算信息' 表单页 (而非任何 picker 已打开).\"\"\"\n    picker, _ = find_current_picker(nodes)\n    if picker is not None:\n        return False\n    has_title = has_step = False\n    for n in nodes:\n        t = n.get(\"text\", \"\")\n        if _rid_ends_with(n, \"titleBarTitle\") and t == FORM_TITLE_TEXT:\n            has_title = True\n        elif _rid_ends_with(n, \"nameTv\") and t == FORM_STEP_TEXT:\n            has_step = True\n    if not (has_title and has_step):\n        return False\n    return current_step_num(nodes) == FORM_STEP_NUM\n\ndef find_content_node_by_label(nodes, label):\n    \"\"\"\n    通过 label (titleNameTv.text) 定位同行 contentEt 节点.\n    返回 node 或 None.\n    \"\"\"\n    label_node = None\n    for n in nodes:\n        if _rid_ends_with(n, \"titleNameTv\") and n.get(\"text\", \"\") == label:\n            label_node = n\n            break\n    if label_node is None:\n        return None\n\n    lb = parse_bounds(label_node.get(\"bounds\", \"\"))\n    if not lb:\n        return None\n    lb_y = (lb[1] + lb[3]) // 2\n\n    best = None\n    best_dy = 1_000_000\n    for n in nodes:\n        if not _rid_ends_with(n, \"contentEt\"):\n            continue\n        b = parse_bounds(n.get(\"bounds\", \"\"))\n        if not b:\n            continue\n        cy = (b[1] + b[3]) // 2\n        dy = abs(cy - lb_y)\n        # 允许一定布局浮动, 同时限定 contentEt 在 label 右侧.\n        if dy <= 80 and b[0] >= lb[2] - 20 and dy < best_dy:\n            best = n\n            best_dy = dy\n    return best\n\ndef find_form_field_content_node(nodes, field_name):\n    label = FORM_FIELDS[field_name][\"label\"]\n    return find_content_node_by_label(nodes, label)\n\ndef read_label_field(nodes, label):\n    n = find_content_node_by_label(nodes, label)\n    if n is None:\n        return None\n    return n.get(\"text\", \"\")\n\ndef read_form_field(nodes, field_name):\n    \"\"\"通过 label (titleNameTv.text) 定位同行的 contentEt.text\"\"\"\n    n = find_form_field_content_node(nodes, field_name)\n    if n is None:\n        return None\n    return n.get(\"text\", \"\")\n\ndef field_tap_points(nodes, field_name):\n    \"\"\"\n    字段点击坐标候选:\n    1) contentEt 中心\n    2) contentEt 偏右 (更接近可点击区域)\n    3) 旧硬编码坐标兜底\n    \"\"\"\n    out = []\n\n    n = find_form_field_content_node(nodes, field_name)\n    if n is not None:\n        b = parse_bounds(n.get(\"bounds\", \"\"))\n        if b:\n            l, t, r, btm = b\n            cy = (t + btm) // 2\n            cx = (l + r) // 2\n            rx = int(l + (r - l) * 0.75)\n            out.append((cx, cy))\n            out.append((rx, cy))\n\n    out.append(FORM_FIELDS[field_name][\"tap_xy\"])\n\n    dedup = []\n    seen = set()\n    for p in out:\n        if p in seen:\n            continue\n        seen.add(p)\n        dedup.append(p)\n    return dedup\n\ndef open_picker_for_field(field_name, picker_name):\n    \"\"\"\n    通过多候选点击点打开 picker, 提升对分辨率/布局偏移的鲁棒性.\n    返回 (ok, attempted_points)\n    \"\"\"\n    nodes = parse_ui(adb_dump_ui())\n    points = field_tap_points(nodes, field_name)\n    attempted = []\n\n    for x, y in points:\n        attempted.append((x, y))\n        adb_tap(x, y)\n        time.sleep(SETTLE_S)\n        if wait_picker(picker_name, want_open=True, tries=5):\n            return True, attempted\n\n        # 若误开了其它 picker, 先取消再继续尝试.\n        nodes = parse_ui(adb_dump_ui())\n        cur, _ = find_current_picker(nodes)\n        if cur is not None and cur != picker_name:\n            adb_tap(*PICKERS[cur][\"cancel_xy\"])\n            time.sleep(SETTLE_S)\n\n    return False, attempted\n\n\n# ==================== 图片上传: 对公户开户凭证 ====================\n\ndef build_remote_voucher_path():\n    ts = int(time.time() * 1000)\n    return f\"{REMOTE_DIR}/_f_settle_{ts}.jpg\"\n\ndef sync_media_scan(remote_path):\n    adb_shell(\n        \"am\", \"broadcast\",\n        \"-a\", \"android.intent.action.MEDIA_SCANNER_SCAN_FILE\",\n        \"-d\", f\"file://{remote_path}\",\n    )\n\ndef scroll_down_small():\n    # 下滑回到更靠上的区域, 且避免从顶部触发下拉刷新.\n    adb_swipe(540, 900, 540, 1700, 260)\n    time.sleep(0.25)\n\ndef find_public_voucher_slot(nodes):\n    slots = find_nodes(nodes, rid_suffix=\"licenseLeftCtl\")\n    if slots:\n        return slots[0]\n    imgs = find_nodes(nodes, rid_suffix=\"licenseLeftIv\")\n    if imgs:\n        return imgs[0]\n    return None\n\ndef ensure_on_form_page():\n    \"\"\"\n    gate_in_form: 在 step3 表单页, 并自动尝试关闭遗留 picker.\n    \"\"\"\n    nodes = parse_ui(adb_dump_ui())\n    if not on_form_page(nodes):\n        picker, _ = find_current_picker(nodes)\n        if picker is not None:\n            adb_tap(*PICKERS[picker][\"cancel_xy\"])\n            time.sleep(SETTLE_S)\n            nodes = parse_ui(adb_dump_ui())\n        if not on_form_page(nodes):\n            picker, _ = find_current_picker(nodes)\n            step = current_step_num(nodes)\n            return None, result_need_llm(\n                \"not_on_form_page\",\n                f\"current_picker={picker} current_step={step}\",\n                f\"python3 {Path(__file__).name} diagnose_page\",\n            )\n    return nodes, 0\n\ndef upload_public_account_voucher():\n    if not os.path.exists(PUBLIC_ACCOUNT_VOUCHER_JPG):\n        return result_need_llm(\n            \"file_not_found\",\n            f\"voucher image not found: {PUBLIC_ACCOUNT_VOUCHER_JPG}\",\n            f\"ls -la {PUBLIC_ACCOUNT_VOUCHER_JPG}\",\n        )\n\n    # 1) 定位上传槽位 (若当前视口不在上方则先下滑几次回到凭证区)\n    slot = None\n    for _ in range(4):\n        nodes = parse_ui(adb_dump_ui())\n        slot = find_public_voucher_slot(nodes)\n        if slot is not None:\n            break\n        scroll_down_small()\n    if slot is None:\n        return result_need_llm(\n            \"image_slot_not_found\",\n            \"cannot find licenseLeftCtl/licenseLeftIv for 公户开户凭证\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n\n    # 2) push 最新图片到相册目录并触发媒体扫描\n    remote_path = build_remote_voucher_path()\n    adb_shell(\"rm\", \"-f\", f\"{REMOTE_DIR}/_f_settle_*.jpg\")\n    _adb(\"push\", PUBLIC_ACCOUNT_VOUCHER_JPG, remote_path)\n    sync_media_scan(remote_path)\n\n    # 3) 点凭证槽位 -> 点“从相册选择”\n    cxcy = _node_center(slot)\n    if cxcy is None:\n        return result_need_llm(\n            \"image_slot_not_found\",\n            \"voucher slot found but bounds invalid\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    adb_tap(*cxcy)\n    time.sleep(SETTLE_S)\n\n    nodes = parse_ui(adb_dump_ui())\n    gallery_tv = find_nodes(nodes, text=\"从相册选择\")\n    if not gallery_tv:\n        return result_need_llm(\n            \"upload_dialog_not_found\",\n            \"after tapping voucher slot, '从相册选择' not found\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    gxy = _node_center(gallery_tv[0])\n    if gxy is None:\n        return result_need_llm(\n            \"upload_dialog_not_found\",\n            \"'从相册选择' found but bounds invalid\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    adb_tap(*gxy)\n    time.sleep(GALLERY_WAIT_S)\n\n    # 4) 相册里点击左上角缩略图 (最新 push 图片)\n    for _ in range(2):\n        scroll_down_small()\n    nodes = parse_ui(adb_dump_ui())\n    pics = find_nodes(nodes, rid_suffix=\"ivPicture\")\n    if not pics:\n        return result_need_llm(\n            \"gallery_not_opened\",\n            \"cannot find ivPicture after tapping 从相册选择\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    pics.sort(key=lambda n: (_node_bounds(n)[1], _node_bounds(n)[0]))\n    pxy = _node_center(pics[0])\n    if pxy is None:\n        return result_need_llm(\n            \"gallery_not_opened\",\n            \"ivPicture found but bounds invalid\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    adb_tap(*pxy)\n    time.sleep(PREVIEW_WAIT_S)\n\n    # 5) 预览页: 勾选 + 完成\n    nodes = parse_ui(adb_dump_ui())\n    chks = find_nodes(nodes, rid_suffix=\"btnCheck\")\n    if not chks:\n        return result_need_llm(\n            \"preview_not_opened\",\n            \"preview page not opened (btnCheck missing)\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    chks.sort(key=lambda n: (-_node_bounds(n)[1], -_node_bounds(n)[0]))\n    cxy = _node_center(chks[0])\n    if cxy is None:\n        return result_need_llm(\n            \"preview_not_opened\",\n            \"btnCheck found but bounds invalid\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    adb_tap(*cxy)\n    time.sleep(0.4)\n\n    nodes = parse_ui(adb_dump_ui())\n    dones = find_nodes(nodes, rid_suffix=\"picture_right\")\n    if not dones:\n        return result_need_llm(\n            \"preview_no_finish\",\n            \"picture_right missing on preview page\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    dxy = _node_center(dones[0])\n    if dxy is None:\n        return result_need_llm(\n            \"preview_no_finish\",\n            \"picture_right found but bounds invalid\",\n            f\"python3 {Path(__file__).name} dump_debug\",\n        )\n    adb_tap(*dxy)\n    time.sleep(UPLOAD_WAIT_S)\n\n    # 6) 上传后回到 step3 表单页\n    nodes = parse_ui(adb_dump_ui())\n    if not on_form_page(nodes):\n        return result_need_llm(\n            \"not_on_form_page\",\n            \"after uploading voucher, not on settlement form page\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    return 0\n\n\n# ==================== 入网资料解析 (动态目标) ====================\n\n_MATERIAL_TARGETS = None\n\nCITY_ALIAS_MAP = {\n    \"北京\": \"北京市\",\n    \"上海\": \"上海市\",\n    \"天津\": \"天津市\",\n    \"重庆\": \"重庆市\",\n    \"成都\": \"成都市\",\n    \"深圳\": \"深圳市\",\n    \"广州\": \"广州市\",\n    \"杭州\": \"杭州市\",\n    \"南京\": \"南京市\",\n    \"武汉\": \"武汉市\",\n    \"西安\": \"西安市\",\n}\n\nCITY_TO_PROV_MAP = {\n    \"北京市\": \"北京市\",\n    \"上海市\": \"上海市\",\n    \"天津市\": \"天津市\",\n    \"重庆市\": \"重庆市\",\n    \"成都市\": \"四川省\",\n    \"深圳市\": \"广东省\",\n    \"广州市\": \"广东省\",\n    \"杭州市\": \"浙江省\",\n    \"南京市\": \"江苏省\",\n    \"武汉市\": \"湖北省\",\n    \"西安市\": \"陕西省\",\n}\n\nBANK_KEYWORDS = [\n    (\"民生\", \"中国民生银行\"),\n    (\"工商\", \"中国工商银行\"),\n    (\"农业\", \"中国农业银行\"),\n    (\"建设\", \"中国建设银行\"),\n    (\"中国银行\", \"中国银行\"),\n    (\"招商\", \"招商银行\"),\n    (\"交通\", \"交通银行\"),\n    (\"邮政储蓄\", \"中国邮政储蓄银行\"),\n    (\"邮储\", \"中国邮政储蓄银行\"),\n    (\"平安\", \"平安银行\"),\n    (\"中信\", \"中信银行\"),\n    (\"光大\", \"中国光大银行\"),\n    (\"浦发\", \"上海浦东发展银行\"),\n    (\"兴业\", \"兴业银行\"),\n]\n\ndef _ocr_lines_from_image(img_path: str):\n    res = get_ocr().predict(str(img_path))\n    out = []\n    if res:\n        rr = res[0]\n        for t in rr.get(\"rec_texts\", []):\n            t = (t or \"\").strip()\n            if t:\n                out.append(t)\n    return out\n\ndef _extract_by_regex(text: str, pattern: str):\n    m = re.search(pattern, text, flags=re.M)\n    if m:\n        return (m.group(1) or \"\").strip()\n    return \"\"\n\ndef _normalize_bank_name(bank_full: str):\n    s = bank_full or \"\"\n    for kw, name in BANK_KEYWORDS:\n        if kw in s:\n            return name\n    m = re.search(r\"(中国[\\u4e00-\\u9fa5]{1,8}银行)\", s)\n    if m:\n        return m.group(1)\n    return \"\"\n\ndef _infer_city_name(*texts):\n    for txt in texts:\n        if not txt:\n            continue\n        m = re.search(r\"([\\u4e00-\\u9fa5]{2,8}市)\", txt)\n        if m:\n            return m.group(1)\n    for txt in texts:\n        if not txt:\n            continue\n        for alias, city in CITY_ALIAS_MAP.items():\n            if alias in txt:\n                return city\n    return \"\"\n\ndef _read_contact_info_text():\n    p = Path(CONTACT_INFO_MD)\n    if not p.exists():\n        return \"\"\n    try:\n        return p.read_text(encoding=\"utf-8\")\n    except Exception:\n        return p.read_text(errors=\"ignore\")\n\ndef load_material_targets(force=False):\n    \"\"\"\n    动态从入网资料解析:\n      account_no / bank_name / city_prov / city_name\n    \"\"\"\n    global _MATERIAL_TARGETS\n    if _MATERIAL_TARGETS is not None and not force:\n        return _MATERIAL_TARGETS, 0\n\n    if not os.path.exists(PUBLIC_ACCOUNT_VOUCHER_JPG):\n        return None, result_need_llm(\n            \"file_not_found\",\n            f\"voucher image not found: {PUBLIC_ACCOUNT_VOUCHER_JPG}\",\n            f\"ls -la {PUBLIC_ACCOUNT_VOUCHER_JPG}\",\n        )\n\n    lines = _ocr_lines_from_image(PUBLIC_ACCOUNT_VOUCHER_JPG)\n    joined = \"\\n\".join(lines)\n\n    account_no = _extract_by_regex(joined, r\"账户号码[:：]\\s*([0-9]{6,})\")\n    bank_full  = _extract_by_regex(joined, r\"开户银行[:：]\\s*(.+)\")\n    bank_name  = _normalize_bank_name(bank_full)\n\n    contact_txt = _read_contact_info_text()\n    city_name = _infer_city_name(joined, bank_full, contact_txt)\n    city_prov = CITY_TO_PROV_MAP.get(city_name, \"\")\n\n    targets = {\n        \"account_no\": account_no,\n        \"bank_name\": bank_name,\n        \"bank_full\": bank_full,\n        \"city_name\": city_name,\n        \"city_prov\": city_prov,\n        \"ocr_lines\": lines,\n    }\n\n    missing = []\n    for k in (\"account_no\", \"bank_name\", \"city_name\", \"city_prov\"):\n        if not targets[k]:\n            missing.append(k)\n    if missing:\n        return None, result_need_llm(\n            \"target_missing\",\n            f\"missing targets from materials: {missing}\",\n            f\"python3 {Path(__file__).name} dump_targets\",\n        )\n\n    _MATERIAL_TARGETS = targets\n    return targets, 0\n\n\n# ==================== OCR ====================\n\n_OCR = None\ndef get_ocr():\n    global _OCR\n    if _OCR is None:\n        from paddleocr import PaddleOCR\n        _OCR = PaddleOCR(use_textline_orientation=False, lang=\"ch\")\n    return _OCR\n\ndef ocr_column(screen_png: Path, bounds):\n    \"\"\"裁 bounds 跑 OCR, 返回 items[{text, y_screen, h, score}] 按 y 升序.\"\"\"\n    from PIL import Image\n    l, t, r, b = bounds\n    roi = Image.open(screen_png).crop((l, t, r, b))\n    tmp = CACHE_DIR / \"_roi.png\"\n    roi.save(tmp)\n    res = get_ocr().predict(str(tmp))\n    items = []\n    if res:\n        rr = res[0]\n        for text, score, poly in zip(\n            rr.get(\"rec_texts\", []),\n            rr.get(\"rec_scores\", []),\n            rr.get(\"rec_polys\", []),\n        ):\n            ys = [p[1] for p in poly]\n            items.append({\n                \"text\": text,\n                \"y_screen\": round(float(sum(ys) / len(ys) + t), 1),\n                \"h\":        round(float(max(ys) - min(ys)), 1),\n                \"score\":    round(float(score), 3),\n            })\n    items.sort(key=lambda i: i[\"y_screen\"])\n    return items\n\ndef fingerprint(items):\n    return tuple((i[\"text\"], round(i[\"y_screen\"])) for i in items)\n\ndef find_selected(items):\n    if not items:\n        return None\n    return max(items, key=lambda i: i[\"h\"])\n\ndef canonical_text(s):\n    s = (s or \"\").strip()\n    # 城市/银行 picker 常见前缀: A-安徽省, B-北京市 ...\n    s = re.sub(r\"^[A-Za-zＡ-Ｚ][\\-\\u2014\\u2013]\", \"\", s)\n    return s.strip()\n\ndef fuzzy_eq(a, b):\n    ca = canonical_text(a)\n    cb = canonical_text(b)\n    if ca == cb:\n        return True\n    return difflib.SequenceMatcher(None, ca, cb).ratio() >= FUZZY_RATIO\n\ndef find_target(items, target):\n    for it in items:\n        if canonical_text(it[\"text\"]) == canonical_text(target):\n            return it\n    for it in items:\n        if fuzzy_eq(it[\"text\"], target):\n            return it\n    return None\n\n\n# ==================== wheel 层: 滚动单列 ====================\n\ndef scroll_column(picker_name, col_cfg, target):\n    pkr = PICKERS[picker_name]\n    col_name   = col_cfg[\"name\"]\n    x          = col_cfg[\"x\"]\n    bounds     = col_cfg[\"bounds\"]\n    blind_step = pkr[\"blind_step_px\"]\n\n    prev_fp = None\n    blind_dir = -1   # -1: swipe up (列表下滚, 看后面的项)\n    stall_count = 0\n\n    for attempt in range(MAX_SCROLL_TRIES):\n        png = adb_screencap()\n        items = ocr_column(png, bounds)\n        if not items:\n            return result_need_llm(\n                \"ocr_empty\",\n                f\"picker={picker_name} col={col_name} attempt={attempt}\",\n                f\"python3 {Path(__file__).name} dump_debug --picker {picker_name}\",\n            )\n\n        current = find_selected(items)\n        if fuzzy_eq(current[\"text\"], target):\n            return result_ok(\n                f\"{picker_name}.{col_name}={current['text']}\",\n                picker=picker_name, col=col_name, tries=attempt,\n            )\n\n        tgt = find_target(items, target)\n        if tgt is not None:\n            start_y = int(round(tgt[\"y_screen\"]))\n            end_y   = int(round(current[\"y_screen\"]))\n            if start_y != end_y:\n                adb_swipe(x, start_y, x, end_y)\n                time.sleep(SETTLE_S)\n                prev_fp = None\n                stall_count = 0\n                continue\n\n        # 目标不可见: 盲滑 + 撞边界检测\n        fp = fingerprint(items)\n        if prev_fp is not None and fp == prev_fp:\n            stall_count += 1\n            if stall_count == 1:\n                blind_dir *= -1\n            else:\n                return result_need_llm(\n                    \"target_not_in_list\",\n                    f\"picker={picker_name} col={col_name} target={target}\"\n                    f\" visible={[i['text'] for i in items]}\",\n                    f\"python3 {Path(__file__).name} list_column\"\n                    f\" --picker {picker_name} --col {col_name}\",\n                )\n        prev_fp = fp\n\n        cy = int(round(current[\"y_screen\"]))\n        low_y = bounds[1] + 40\n        high_y = bounds[3] - 40\n        if blind_dir < 0:\n            start_y = min(high_y, cy + blind_step)\n            end_y = max(low_y, cy)\n            if start_y <= end_y:\n                start_y = high_y\n                end_y = max(low_y, high_y - 220)\n        else:\n            start_y = max(low_y, cy - blind_step)\n            end_y = min(high_y, cy)\n            if start_y >= end_y:\n                start_y = low_y\n                end_y = min(high_y, low_y + 220)\n        adb_swipe(x, start_y, x, end_y)\n        time.sleep(SETTLE_S)\n\n    return result_need_llm(\n        \"scroll_exhausted\",\n        f\"picker={picker_name} col={col_name} target={target} tries={MAX_SCROLL_TRIES}\",\n        f\"python3 {Path(__file__).name} list_column --picker {picker_name} --col {col_name}\",\n    )\n\n\n# ==================== wheel 层: 选一个 picker 的所有列 ====================\n\ndef wait_picker(picker_name, want_open: bool, tries=10):\n    for _ in range(tries):\n        nodes = parse_ui(adb_dump_ui())\n        cur, _ = find_current_picker(nodes)\n        if want_open and cur == picker_name:\n            return True\n        if (not want_open) and cur is None:\n            return True\n        time.sleep(0.3)\n    return False\n\ndef select_wheel(picker_name, targets: dict, picker_already_open=False):\n    pkr = PICKERS[picker_name]\n\n    if (not picker_already_open) and (not wait_picker(picker_name, want_open=True)):\n        return result_need_llm(\n            \"picker_not_open\",\n            f\"expected picker={picker_name} but not found after tap\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    for col_cfg in pkr[\"columns\"]:\n        col_name = col_cfg[\"name\"]\n        if col_name not in targets:\n            return result_err(f\"missing target for column '{col_name}' in {picker_name}\")\n        rc = scroll_column(picker_name, col_cfg, targets[col_name])\n        if rc != 0:\n            return rc\n\n    adb_tap(*pkr[\"confirm_xy\"])\n    time.sleep(SETTLE_S)\n\n    if not wait_picker(picker_name, want_open=False):\n        return result_need_llm(\n            \"confirm_failed\",\n            f\"picker={picker_name} still open after confirm tap\",\n            f\"python3 {Path(__file__).name} dump_debug --picker {picker_name}\",\n        )\n    return 0\n\n\n# ==================== 表单层: 填一个字段 ====================\n\ndef fill_field(field_name):\n    fc = FORM_FIELDS[field_name]\n    picker_name = fc[\"opens\"]\n    target      = fc[\"target\"]\n\n    # 幂等: 如果已填且 = target 直接跳过 (避免多次打开 picker 产生副作用)\n    nodes = parse_ui(adb_dump_ui())\n    shown0 = read_form_field(nodes, field_name)\n    if shown0 and shown0 != fc[\"placeholder\"] and fuzzy_eq(shown0, target):\n        return result_ok(f\"{field_name}={shown0} (already filled)\", field=field_name)\n\n    # 1. tap 字段触发 picker (动态坐标 + 兜底重试)\n    opened, attempted = open_picker_for_field(field_name, picker_name)\n    if not opened:\n        return result_need_llm(\n            \"picker_not_open\",\n            f\"field={field_name} picker={picker_name} attempted_taps={attempted}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    # 2. 滚轮选择 + 确认关闭\n    rc = select_wheel(picker_name, {\"v\": target}, picker_already_open=True)\n    if rc != 0:\n        return rc\n\n    # 3. 验证回写\n    nodes = parse_ui(adb_dump_ui())\n    if not on_form_page(nodes):\n        return result_need_llm(\n            \"not_on_form_page\",\n            f\"after filling {field_name} but form not visible\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    shown = read_form_field(nodes, field_name)\n    if shown is None:\n        return result_need_llm(\n            \"field_not_found\",\n            f\"field={field_name}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    if shown == fc[\"placeholder\"] or not fuzzy_eq(shown, target):\n        return result_need_llm(\n            \"field_mismatch\",\n            f\"field={field_name} expected={target!r} shown={shown!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    return result_ok(f\"{field_name}={shown}\", field=field_name)\n\ndef ensure_label_visible(label, tries=5):\n    \"\"\"\n    通过小幅上滑滚动表单，确保目标 label 出现在当前视口.\n    \"\"\"\n    for _ in range(tries):\n        nodes = parse_ui(adb_dump_ui())\n        if find_content_node_by_label(nodes, label) is not None:\n            return nodes\n        adb_swipe(540, 1700, 540, 700, 350)\n        time.sleep(SETTLE_S)\n    return None\n\ndef fill_account_number(account_target):\n    nodes = ensure_label_visible(\"账号\")\n    if nodes is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=账号 not visible after scrolling\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    shown0 = read_label_field(nodes, \"账号\")\n    if shown0 and account_target in shown0:\n        return 0\n\n    n = find_content_node_by_label(nodes, \"账号\")\n    if n is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=账号 content node missing\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    c = _node_center(n)\n    if c is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=账号 bounds invalid\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    adb_tap(*c)\n    time.sleep(0.25)\n    adb_shell(\"input\", \"keyevent\", \"123\")  # KEYCODE_MOVE_END\n    for _ in range(24):\n        adb_shell(\"input\", \"keyevent\", \"67\")  # KEYCODE_DEL\n    adb_shell(\"input\", \"text\", account_target)\n    time.sleep(0.35)\n    adb_shell(\"input\", \"keyevent\", \"4\")  # 收起键盘\n    time.sleep(SETTLE_S)\n\n    nodes = parse_ui(adb_dump_ui())\n    shown = read_label_field(nodes, \"账号\")\n    if not shown or account_target not in shown:\n        return result_need_llm(\n            \"field_mismatch\",\n            f\"field=账号 expected contains {account_target!r} shown={shown!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    return 0\n\ndef fill_city_picker(city_prov_target, city_name_target):\n    nodes = ensure_label_visible(\"开户城市\")\n    if nodes is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户城市 not visible after scrolling\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    shown0 = read_label_field(nodes, \"开户城市\")\n    if shown0 and city_name_target in shown0:\n        return 0\n\n    n = find_content_node_by_label(nodes, \"开户城市\")\n    if n is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户城市 content node missing\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    c = _node_center(n)\n    if c is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户城市 bounds invalid\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    adb_tap(*c)\n    time.sleep(SETTLE_S)\n    rc = select_wheel(\n        \"city_picker\",\n        {\"prov\": city_prov_target, \"city\": city_name_target},\n        picker_already_open=False,\n    )\n    if rc != 0:\n        return rc\n\n    nodes = parse_ui(adb_dump_ui())\n    shown = read_label_field(nodes, \"开户城市\")\n    if not shown or city_name_target not in shown:\n        return result_need_llm(\n            \"field_mismatch\",\n            f\"field=开户城市 expected contains {city_name_target!r} shown={shown!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    return 0\n\n# ==================== uiautomator2 桥接 ====================\n# 仅用于\"开户行名称\"下拉建议 PopupWindow 的捕获 —\n# 该 popup 是 ListPopupWindow, 标准 `uiautomator dump` 抓不到,\n# 但 u2 (ATX-Agent, 走 accessibility) 可以.\n\n_U2 = None\ndef get_u2():\n    global _U2\n    if _U2 is None:\n        import uiautomator2 as u2\n        _U2 = u2.connect(DEVICE)\n    return _U2\n\ndef u2_find_branch_suggestion(keywords):\n    \"\"\"\n    在 u2 hierarchy 里找 `autoItemTv` 节点, 返回第一个文本含任一 keyword 的项.\n    返回 (cx, cy, text) 或 None.\n    \"\"\"\n    d = get_u2()\n    xml = d.dump_hierarchy()\n    items = []\n    for m in re.finditer(r'<node[^>]*/?>', xml):\n        s = m.group(0)\n        rid_m = re.search(r'resource-id=\"([^\"]*)\"', s)\n        rid = rid_m.group(1) if rid_m else \"\"\n        if not rid.endswith(\"autoItemTv\"):\n            continue\n        t_m = re.search(r'text=\"([^\"]*)\"', s)\n        t = t_m.group(1) if t_m else \"\"\n        b_m = re.search(r'bounds=\"([^\"]*)\"', s)\n        bb = parse_bounds(b_m.group(1) if b_m else \"\")\n        if not t or not bb or bb[2] <= bb[0] or bb[3] <= bb[1]:\n            continue\n        items.append((bb, t))\n    if not items:\n        return None\n    # 关键字匹配优先\n    for bb, t in items:\n        if any(k and k in t for k in keywords):\n            cx = (bb[0] + bb[2]) // 2\n            cy = (bb[1] + bb[3]) // 2\n            return cx, cy, t\n    # 兜底: 取第一个有效项\n    bb, t = items[0]\n    return (bb[0] + bb[2]) // 2, (bb[1] + bb[3]) // 2, t\n\ndef adb_input_chinese(text: str):\n    \"\"\"通过 ADBKeyBoard 广播注入 UTF-8 文本 (input text 不支持中文).\"\"\"\n    adb_shell(\"am\", \"broadcast\", \"-a\", \"ADB_INPUT_TEXT\", \"--es\", \"msg\", text)\n\n\n# ==================== 开户行名称 (AutoCompleteTextView + dropdown) ====================\n\ndef _branch_code_filled(nodes):\n    \"\"\"行号字段是否已自动回填 (bounds 有效 & 非占位符).\"\"\"\n    n = find_content_node_by_label(nodes, \"开户行行号\")\n    if n is None:\n        return False, None\n    b = _node_bounds(n)\n    t = n.get(\"text\", \"\") or \"\"\n    if not b:\n        return False, t\n    if not t or t.startswith(\"请输入\"):\n        return False, t\n    return True, t\n\ndef fill_branch_name(bank_full, bank_name):\n    \"\"\"\n    填写 '开户行名称' (AutoCompleteTextView):\n      1. 滚动到 label 可见\n      2. tap → 清空 → ADBKeyBoard 注入全称\n      3. 等下拉 → u2 抓 autoItemTv → tap\n      4. 验证 '开户行行号' 自动回填\n    \"\"\"\n    nodes = ensure_label_visible(\"开户行名称\")\n    if nodes is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户行名称 not visible after scrolling\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    name_node = find_content_node_by_label(nodes, \"开户行名称\")\n    if name_node is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户行名称 content node missing\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    # 幂等: 名称已含全称关键片段 & 行号已自动填\n    shown0 = name_node.get(\"text\", \"\") or \"\"\n    code_ok, code_text0 = _branch_code_filled(nodes)\n    key = bank_full[:6] if bank_full else \"\"\n    if shown0 and not shown0.startswith(\"请输入\") and key and key in shown0 and code_ok:\n        return result_ok(\n            f\"branch_name={shown0} branch_code={code_text0} (already filled)\",\n            field=\"branch_name\",\n        )\n\n    c = _node_center(name_node)\n    if c is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户行名称 bounds invalid\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    # tap + 清空 + 注入中文\n    adb_tap(*c)\n    time.sleep(0.3)\n    adb_shell(\"input\", \"keyevent\", \"123\")  # MOVE_END\n    for _ in range(60):\n        adb_shell(\"input\", \"keyevent\", \"67\")  # DEL\n    time.sleep(0.2)\n    adb_input_chinese(bank_full)\n    time.sleep(BRANCH_DROPDOWN_WAIT_S)\n\n    # u2 找下拉建议项 (stock dump 抓不到 PopupWindow)\n    keywords = [k for k in (bank_name, bank_full[:6], \"银行\") if k]\n    try:\n        item = u2_find_branch_suggestion(keywords)\n    except Exception as e:\n        return result_need_llm(\n            \"branch_dropdown_not_found\",\n            f\"u2 hierarchy error: {type(e).__name__}: {e}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    if item is None:\n        return result_need_llm(\n            \"branch_dropdown_not_found\",\n            f\"no autoItemTv after typing {bank_full!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    ix, iy, item_text = item\n    adb_tap(ix, iy)\n    time.sleep(SETTLE_S)\n\n    # 验证: 行号自动回填 (adb_dump_ui 偶发失败, 降级到 NEED_LLM 而非 ERROR)\n    try:\n        nodes = parse_ui(adb_dump_ui())\n    except RuntimeError as e:\n        return result_need_llm(\n            \"adb_dump_ui_failed\",\n            f\"fill_branch_name verify: {e}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    code_ok, code_text = _branch_code_filled(nodes)\n    if not code_ok:\n        return result_need_llm(\n            \"branch_code_not_filled\",\n            f\"tapped suggestion={item_text!r} but 开户行行号={code_text!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    shown = read_label_field(nodes, \"开户行名称\") or \"\"\n    return result_ok(\n        f\"branch_name={shown} branch_code={code_text}\",\n        field=\"branch_name\",\n        suggestion=item_text,\n    )\n\n\ndef fill_bank_picker(bank_target):\n    nodes = ensure_label_visible(\"开户银行\")\n    if nodes is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户银行 not visible after scrolling\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    shown0 = read_label_field(nodes, \"开户银行\")\n    if shown0 and shown0 != \"请选择开户银行\" and fuzzy_eq(shown0, bank_target):\n        return 0\n\n    n = find_content_node_by_label(nodes, \"开户银行\")\n    if n is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户银行 content node missing\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    c = _node_center(n)\n    if c is None:\n        return result_need_llm(\n            \"field_not_found\",\n            \"field=开户银行 bounds invalid\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n\n    adb_tap(*c)\n    time.sleep(SETTLE_S)\n    rc = select_wheel(\"bank_picker\", {\"v\": bank_target}, picker_already_open=False)\n    if rc != 0:\n        return rc\n\n    nodes = parse_ui(adb_dump_ui())\n    shown = read_label_field(nodes, \"开户银行\")\n    if shown is None or shown == \"请选择开户银行\" or not fuzzy_eq(shown, bank_target):\n        return result_need_llm(\n            \"field_mismatch\",\n            f\"field=开户银行 expected={bank_target!r} shown={shown!r}\",\n            f\"python3 {Path(__file__).name} diagnose_page\",\n        )\n    return 0\n\n\n# ==================== 子命令 ====================\n\ndef cmd_diagnose_page():\n    nodes = parse_ui(adb_dump_ui())\n    picker_name, title = find_current_picker(nodes)\n    on_form = on_form_page(nodes)\n    form = {}\n    if on_form:\n        for f in FORM_FIELDS:\n            form[f] = read_form_field(nodes, f)\n    tt = [n.get(\"text\", \"\") for n in nodes\n          if _rid_ends_with(n, \"titleBarTitle\")]\n    print(json.dumps({\n        \"status\": \"OK\",\n        \"on_form_page\": on_form,\n        \"current_step\": current_step_num(nodes),\n        \"current_picker\": picker_name,\n        \"picker_title\": title,\n        \"titlebar\": tt[0] if tt else \"\",\n        \"form_fields\": form,\n    }, ensure_ascii=False, indent=2))\n    return 0\n\ndef cmd_dump_debug(args):\n    png = adb_screencap()\n    xml_p = adb_dump_ui()\n    out = {\"screen_png\": str(png), \"ui_xml\": str(xml_p)}\n    if args.picker:\n        pkr = PICKERS[args.picker]\n        cols_out = {}\n        for col in pkr[\"columns\"]:\n            cols_out[col[\"name\"]] = ocr_column(png, col[\"bounds\"])\n        out[\"ocr\"] = cols_out\n    (CACHE_DIR / \"debug.json\").write_text(json.dumps(out, ensure_ascii=False, indent=2))\n    print(json.dumps({\"status\": \"OK\", **out}, ensure_ascii=False))\n    return 0\n\ndef cmd_list_column(args):\n    png = adb_screencap()\n    pkr = PICKERS[args.picker]\n    col_cfg = next((c for c in pkr[\"columns\"] if c[\"name\"] == args.col), None)\n    if col_cfg is None:\n        return result_err(f\"unknown col '{args.col}' in {args.picker}\")\n    items = ocr_column(png, col_cfg[\"bounds\"])\n    selected = find_selected(items)\n    print(json.dumps({\n        \"status\": \"OK\",\n        \"picker\": args.picker,\n        \"col\": args.col,\n        \"selected\": selected[\"text\"] if selected else None,\n        \"items\": items,\n    }, ensure_ascii=False, indent=2))\n    return 0\n\ndef cmd_dump_targets():\n    targets, rc = load_material_targets(force=True)\n    if rc != 0:\n        return rc\n    print(json.dumps({\n        \"status\": \"OK\",\n        \"targets\": {\n            \"account_no\": targets[\"account_no\"],\n            \"bank_name\": targets[\"bank_name\"],\n            \"bank_full\": targets[\"bank_full\"],\n            \"city_name\": targets[\"city_name\"],\n            \"city_prov\": targets[\"city_prov\"],\n        },\n        \"ocr_lines\": targets[\"ocr_lines\"],\n    }, ensure_ascii=False, indent=2))\n    return 0\n\ndef cmd_upload_voucher():\n    _, rc = ensure_on_form_page()\n    if rc != 0:\n        return rc\n    rc = upload_public_account_voucher()\n    if rc != 0:\n        return rc\n    return result_ok(\n        \"public_account_voucher_uploaded\",\n        image=PUBLIC_ACCOUNT_VOUCHER_JPG,\n    )\n\ndef cmd_run_all():\n    # 1. gate_in_form (自动恢复上次失败留下的 picker)\n    _, rc = ensure_on_form_page()\n    if rc != 0:\n        return rc\n\n    # 2. upload voucher image\n    rc = upload_public_account_voucher()\n    if rc != 0:\n        return rc\n\n    # 3. load dynamic targets from onboarding materials\n    targets, rc = load_material_targets()\n    if rc != 0:\n        return rc\n\n    # 4. fill method\n    rc = fill_field(\"method\")\n    if rc != 0:\n        return rc\n\n    # 5. fill cycle\n    rc = fill_field(\"cycle\")\n    if rc != 0:\n        return rc\n\n    # 6. fill account/bank fields\n    rc = fill_account_number(targets[\"account_no\"])\n    if rc != 0:\n        return rc\n\n    rc = fill_city_picker(targets[\"city_prov\"], targets[\"city_name\"])\n    if rc != 0:\n        return rc\n\n    rc = fill_bank_picker(targets[\"bank_name\"])\n    if rc != 0:\n        return rc\n\n    # 7. fill branch name (AutoCompleteTextView + popup dropdown via u2)\n    rc = fill_branch_name(targets[\"bank_full\"], targets[\"bank_name\"])\n    if rc != 0:\n        return rc\n\n    return result_ok(\n        \"step3_settlement_filled\",\n        method=METHOD_TARGET, cycle=CYCLE_TARGET,\n        account_no=targets[\"account_no\"],\n        city=f\"{targets['city_prov']}-{targets['city_name']}\",\n        bank=targets[\"bank_name\"],\n        branch=targets[\"bank_full\"],\n    )\n\n\n# ==================== main ====================\n\ndef main():\n    p = argparse.ArgumentParser()\n    sub = p.add_subparsers(dest=\"cmd\", required=True)\n\n    sub.add_parser(\"run_all\")\n    sub.add_parser(\"upload_voucher\")\n    sub.add_parser(\"dump_targets\")\n    sub.add_parser(\"diagnose_page\")\n\n    sp_dbg = sub.add_parser(\"dump_debug\")\n    sp_dbg.add_argument(\"--picker\", default=\"\",\n                        choices=[\"\"] + list(PICKERS.keys()))\n\n    sp_list = sub.add_parser(\"list_column\")\n    sp_list.add_argument(\"--picker\", required=True, choices=list(PICKERS.keys()))\n    sp_list.add_argument(\"--col\",    required=True)\n\n    args = p.parse_args()\n    try:\n        if   args.cmd == \"run_all\":       return cmd_run_all()\n        elif args.cmd == \"upload_voucher\": return cmd_upload_voucher()\n        elif args.cmd == \"dump_targets\":  return cmd_dump_targets()\n        elif args.cmd == \"diagnose_page\": return cmd_diagnose_page()\n        elif args.cmd == \"dump_debug\":    return cmd_dump_debug(args)\n        elif args.cmd == \"list_column\":   return cmd_list_column(args)\n    except Exception as e:\n        import traceback\n        traceback.print_exc()\n        return result_err(f\"{type(e).__name__}: {e}\")\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}],"isError":false,"timestamp":1776304947301}}
