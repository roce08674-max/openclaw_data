\\n    \\\"\\\"\\\"\\n    for attempt in range(retries):\\n        try:\\n            # dump 本身可能慢一点\\n            _adb(\\\"shell\\\", \\\"uiautomator\\\", \\\"dump\\\", \\\"/sdcard/_ui.xml\\\", timeout=60)\\n            _adb(\\\"pull\\\", \\\"/sdcard/_ui.xml\\\", str(dst), timeout=60)\\n            return dst\\n        except Exception:\\n            if attempt == retries - 1:\\n                raise\\n            time.sleep(0.8)\\n\"}"}],"api":"openai-codex-responses","provider":"openai-codex","model":"gpt-5.2","usage":{"input":12509,"output":498,"cacheRead":30592,"cacheWrite":0,"totalTokens":43599,"cost":{"input":0.02189075,"output":0.006972,"cacheRead":0.0053536,"cacheWrite":0,"total":0.03421635}},"stopReason":"toolUse","timestamp":1776304947308}}
