xt_to' style='background:#5192ED; color:#fff'>\\\\\\\"+confirmBtn+\\\\\\\"</a>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"<a href='javascript:;' name='cancel' style='background:#eee; color:#666;'>\\\\\\\"+cancelBtn+\\\\\\\"</a>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\\\\"</div>\\\\\\\"+\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\\\\"</div>\\\\\\\"+\\\\n\\\\t\\\\\\\"</div>\\\\\\\";\\\\t\\\\n\\\\tif($('.TipsBox').length>0){$('.TipsBox').remove();}\\\\t\\\\t\\\\t\\\\n\\\\t$(\\\\\\\"body\\\\\\\").append(popstr);\\\\t\\\\n\\\\t$(\\\\\\\"[name='cancel']\\\\\\\").on('click',function(){ //关闭弹窗提示\\\\n\\\\t\\\\t$(\\\\\\\".TipsBox\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"none\\\\\\\");\\\\n\\\\t\\\\tif(cancel){cancel();}\\\\t\\\\n\\\\t});\\\\n\\\\t$(\\\\\\\"[name='next_to']\\\\\\\").on('click',function(){ //确定继续操作\\\\n\\\\t\\\\t$(\\\\\\\".TipsBox\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"none\\\\\\\");\\\\n\\\\t\\\\tif(callback){callback();}\\\\t\\\\n\\\\t});\\\\n } \\\\n\\\\n\\\\nfunction mdfFn(opt) {\\\\n\\\\tvar loginId = $(\\\\\\\"#loginId\\\\\\\").val();\\\\n\\\\tvar oldPwd = $(\\\\\\\"#oldPwd\\\\\\\").val();\\\\n\\\\tvar newPwd = $(\\\\\\\"#newPwd\\\\\\\").val();\\\\n\\\\tvar againPwd = $(\\\\\\\"#againPwd\\\\\\\").val();\\\\n\\\\n\\\\tif (oldPwd == \\\\\\\"\\\\\\\" || newPwd == \\\\\\\"\\\\\\\" || againPwd == \\\\\\\"\\\\\\\") {\\\\n\\\\t\\\\talert(\\\\\\\"旧密码，新密码，再次输入新密码不能为空！\\\\\\\");\\\\n\\\\t\\\\tdocument.all.oldPwd.focus();\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\tif (newPwd != againPwd) {\\\\n\\\\t\\\\talert(\\\\\\\"两次输入的新密码不一致！\\\\\\\");\\\\n\\\\t\\\\tdocument.all.newPwd.focus();\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\tif (!(function() {\\\\n\\\\t        var pwd = $(\\\\\\\"#newPwd\\\\\\\").val();\\\\n    \\\\t\\\\tvar reg1 = /^\\\\\\\\w{8}\\\\\\\\w*$/;\\\\n    \\\\t\\\\tvar reg2 = /^\\\\\\\\w*[a-zA-Z]+[0-9]+\\\\\\\\w*|\\\\\\\\w*[0-9]+[a-zA-Z]+\\\\\\\\w*$/;\\\\n    \\\\t\\\\tif (!reg1.test(pwd) || !reg2.test(pwd)){\\\\n    \\\\t\\\\t      alert(\\\\\\\"登录密码至少为8位，且至少包含一位数字和字母\\\\\\\");\\\\n                      return false;\\\\n    \\\\t\\\\t}\\\\n\\\\t    \\\\t\\\\t/* var reg1 = /^\\\\\\\\w+$/,reg2 = /^\\\\\\\\w{8}\\\\\\\\w*$/,reg3 = /^\\\\\\\\w*[a-zA-Z]+[0-9]+\\\\\\\\w*|\\\\\\\\w*[0-9]+[a-zA-Z]+\\\\\\\\w*$/;\\\\n\\\\t    \\\\t\\\\tvar arr = [[reg1,\\\\\\\"新密码只允许字母或数字\\\\\\\"],[reg2,\\\\\\\"新密码至少为8位\\\\\\\"],[reg3,\\\\\\\"新密码至少包含一位数字和字母\\\\\\\"]];\\\\n    \\\\t\\\\t\\\\n\\\\t    \\\\t\\\\tfor(var i = 0; i < arr.length; i++){\\\\n\\\\t    \\\\t\\\\t\\\\tif (!arr[i][0].test(pwd)){\\\\n\\\\t    \\\\t\\\\t\\\\t\\\\talert(arr[i][1]);\\\\n\\\\t    \\\\t\\\\t\\\\t\\\\treturn false;\\\\n\\\\t    \\\\t\\\\t\\\\t}\\\\n\\\\t    \\\\t\\\\t} */\\\\n\\\\t\\\\treturn true;\\\\n\\\\t\\\\t})()) {\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\t$('.loading_pop').show();\\\\n\\\\t$.ajax({\\\\n\\\\t\\\\turl: \\\\\\\"Login.fuiou\\\\\\\",\\\\n\\\\t\\\\ttype: \\\\\\\"post\\\\\\\",\\\\n\\\\t\\\\tdataType: \\\\\\\"json\\\\\\\",\\\\n\\\\t\\\\tdata: {\\\\n\\\\t\\\\t\\\\taction: \\\\\\\"mdyPwd\\\\\\\",\\\\n\\\\t\\\\t\\\\tloginId: loginId,\\\\n\\\\t\\\\t\\\\toldPwd: oldPwd,\\\\n\\\\t\\\\t\\\\tnewPwd: newPwd\\\\n\\\\t\\\\t},\\\\n\\\\t\\\\tsuccess: function(data) {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t\\\\talert(data.msg);\\\\n\\\\t\\\\t\\\\tif (data.code == '0') {\\\\n\\\\t\\\\t\\\\t\\\\t$(\\\\\\\"#addAlert\\\\\\\").remove();\\\\n\\\\t\\\\t\\\\t\\\\t// 成功后，刷新该页面self.location.replace(location.href);\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\t,error:function() {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t}\\\\n\\\\t});\\\\n\\\\n};\\\\n\\\\t\\\\t\\\\t\\\\n$(\\\\\\\"#togglePassword\\\\\\\").click(function(){\\\\n\\\\tif($(this).hasClass(\\\\\\\"on\\\\\\\")){\\\\n\\\\t\\\\t$(this).removeClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"password\\\\\\\");\\\\n\\\\t}else{\\\\n\\\\t\\\\t$(this).addClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"text\\\\\\\");\\\\n\\\\t}\\\\n});\\\\n\\\\n$(\\\\\\\"#togglePhonePassword\\\\\\\").click(function(){\\\\n\\\\tif($(this).hasClass(\\\\\\\"on\\\\\\\")){\\\\n\\\\t\\\\t$(this).removeClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPhonePwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"password\\\\\\\");\\\\n\\\\t}else{\\\\n\\\\t\\\\t$(this).addClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPhonePwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"text\\\\\\\");\\\\n\\\\t}\\\\n});\\\\n\\\\n// 手机号绑定确定提交\\\\nfunction bindPhone_submit() {\\\\n\\\\tvar sysLoginId = $(\\\\\\\"#sysLoginId\\\\\\\").val();\\\\n\\\\tif(!sysLoginId) {\\\\n\\\\t\\\\talert(\\\\\\\"系统账号不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar sysLoginIdPwd = $(\\\\\\\"#sysLoginIdPwd\\\\\\\").val();\\\\n\\\\tif(!sysLoginIdPwd) {\\\\n\\\\t\\\\talert(\\\\\\\"系统账号密码不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar bindPhone = $(\\\\\\\"#bindPhone\\\\\\\").val();\\\\n\\\\tif(!sysLoginIdPwd) {\\\\n\\\\t\\\\talert(\\\\\\\"系统账号密码不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar phonePwd = $(\\\\\\\"#phonePwd\\\\\\\").val();\\\\n\\\\tif(!phonePwd) {\\\\n\\\\t\\\\talert(\\\\\\\"手机号登录密码不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar bindShortCode = $(\\\\\\\"#bindShortCode\\\\\\\").val();\\\\n\\\\tif(!bindShortCode) {\\\\n\\\\t\\\\talert(\\\\\\\"短信验证码不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\t\\\\n\\\\t$('.loading_pop').show();\\\\n\\\\t$.ajax({\\\\n\\\\t\\\\turl: \\\\\\\"Login.fuiou\\\\\\\",\\\\n\\\\t\\\\ttype: \\\\\\\"post\\\\\\\",\\\\n\\\\t\\\\tdataType: \\\\\\\"json\\\\\\\",\\\\n\\\\t\\\\tdata: {\\\\n\\\\t\\\\t\\\\t\\\\\\\"action\\\\\\\": \\\\\\\"addUserFirst\\\\\\\",\\\\n\\\\t\\\\t\\\\t\\\\\\\"bindLoginId\\\\\\\": sysLoginId,\\\\n\\\\t\\\\t\\\\t\\\\\\\"pwd\\\\\\\":sysLoginIdPwd,\\\\n\\\\t\\\\t\\\\t\\\\\\\"rem2\\\\\\\": bindShortCode,\\\\n\\\\t\\\\t\\\\t\\\\\\\"loginPhone\\\\\\\": bindPhone,\\\\n\\\\t\\\\t\\\\t\\\\\\\"loginPwd\\\\\\\":phonePwd\\\\n\\\\t\\\\t},\\\\n\\\\t\\\\tsuccess: function(res) {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t\\\\talert(res.msg);\\\\n\\\\t\\\\t\\\\tif (res.code == 0) {\\\\n\\\\t\\\\t\\\\t\\\\tbindPhone_cancel();\\\\n\\\\t\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\t,error:function() {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t}\\\\n\\\\t});\\\\n\\\\t\\\\n}\\\\n\\\\n//隐藏绑定用户弹出框\\\\nfunction bindPhone_cancel() {\\\\n\\\\t$(\\\\\\\".bindconent\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"none\\\\\\\")\\\\n}\\\\n\\\\n// 显示用户弹出框\\\\nfunction bindPhone_show() {\\\\n    //clearInterval(timerId)\\\\n\\\\trefreshCode();\\\\n\\\\t$(\\\\\\\".bindconent\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"flex\\\\\\\");\\\\n\\\\tclearSlide();//隐藏\\\\n}\\\"]\"}"}],"details":{"status":"completed","exitCode":0,"durationMs":93,"aggregated":"{\"status\": \"done\", \"result\": \"[\\\"手机号码\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t动态密码\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t获取动态密码\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t动态密码有误！\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t业务类型\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t请选择您要咨询的业务类型\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t收件宝\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t信用卡还款\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t手机充值\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t金账户/代收付\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t预付卡/福利高\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t商户收单\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t境外支付\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t其他\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t验证码\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t登录\\\",\\\"验证码\\\",\\\"获取验证码\\\",\\\"手机号+验证码登录\\\",\\\"输入验证码\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t \\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t确定\\\",\\\"输入验证码\\\",\\\"绑定用户\\\\n\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t系统账号：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t系统密码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t绑定手机号：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t手机登录密码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t图形验证码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t短信验证码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t获取验证码\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\n\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t确定\\\\n\\\\t\\\\t\\\\t取消\\\",\\\"系统账号：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t系统密码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t绑定手机号：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t手机登录密码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t图形验证码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t短信验证码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t获取验证码\\\",\\\"图形验证码：\\\",\\\"短信验证码：\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\t获取验证码\\\",\\\"短信验证码：\\\",\\\"请滑动滑块\\\",\\\"$(function(){\\\\n\\\\t//console.log(\\\\\\\"123\\\\\\\");\\\\n\\\\tconsole.log(document.querySelector('#slider_nc'), document.querySelector('#hiddenTrigger'));\\\\n\\\\t// ====== 阿里云滑动验证：只初始化一次 ======\\\\n\\\\tvar captcha;\\\\n\\\\ttry {\\\\n\\\\t\\\\tinitAliyunCaptcha({\\\\n\\\\t\\\\t\\\\tSceneId: '1l5vwz7g',\\\\n\\\\t\\\\t\\\\tprefix: '16j5dd',\\\\n\\\\t\\\\t\\\\tmode: 'popup',\\\\n\\\\t\\\\t\\\\telement: '#slider_nc',\\\\n\\\\t\\\\t\\\\tbutton: '#hiddenTrigger',\\\\n\\\\t\\\\t\\\\tcaptchaVerifyCallback: captchaVerifyCallback,\\\\n\\\\t\\\\t\\\\tonBizResultCallback: onBizResultCallback,\\\\n\\\\t\\\\t\\\\tgetInstance: getInstance,\\\\n\\\\t\\\\t\\\\tslideStyle: { width: 360, height: 40 },\\\\n\\\\t\\\\t\\\\tlanguage: 'cn',\\\\n\\\\t\\\\t\\\\tregion: 'cn',\\\\n\\\\t\\\\t\\\\timmediate: true,\\\\n\\\\t\\\\t\\\\tverifyResultInf: {}\\\\n\\\\t\\\\t});\\\\n\\\\t} catch (error) {\\\\n\\\\t\\\\tconsole.error('阿里云验证码初始化失败:', error);\\\\n\\\\t\\\\talert('验证码组件加载失败，请刷新页面重试或联系客服');\\\\n\\\\t}\\\\n\\\\n\\\\tfunction getInstance(instance) {\\\\n\\\\t\\\\tcaptcha = instance;\\\\n\\\\t}\\\\n\\\\n\\\\t// 根据触发来源执行对应业务，返回Promise\\\\n\\\\tasync function captchaVerifyCallback(captchaVerifyParam) {\\\\n\\\\t\\\\tif (!captchaVerifyParam) {\\\\n\\\\t\\\\t\\\\talert(\\\\\\\"阿里云验证码失败，请刷新页面重试！\\\\\\\");\\\\n\\\\t\\\\t\\\\treturn Promise.resolve({ captchaResult: true, bizResult: false });\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\tif (buttonType == 1) {\\\\n\\\\t\\\\t\\\\tconsole.log('调用方法', unifyLoginEnter);\\\\n\\\\t\\\\t\\\\treturn unifyLoginEnter(captchaVerifyParam);\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\tif (buttonType == 2) {\\\\n\\\\t\\\\t\\\\tconsole.log('调用方法', verifyPhoneCode);\\\\n\\\\t\\\\t\\\\treturn verifyPhoneCode(captchaVerifyParam);\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\treturn Promise.resolve({ captchaResult: false, bizResult: false });\\\\n\\\\t}\\\\n\\\\n\\\\tfunction onBizResultCallback(bizResult) {\\\\n\\\\t\\\\t// 可按需扩展（目前由各业务函数内处理倒计时/提示）\\\\n\\\\t\\\\ttry { /* no-op */ } catch(e) {}\\\\n\\\\t}\\\\n\\\\n\\\\t// 先刷\\\\n\\\\trefreshCode();\\\\n})\\\\n  // 初始化阿里云滑动验证\\\\n //  AWSC.use(\\\\\\\"nvc\\\\\\\", function (state, module) {\\\\n //      // 初始化 调用module.init进行初始化\\\\n //      window.nvc = module.init({\\\\n //          // 应用类型标识。它和使用场景标识（scene字段）一起决定了无痕验证的业务场景与后端对应使用的策略模型。您可以在阿里云验证码控制台的配置管理页签找到对应的appkey字段值，请务必正确填写。\\\\n //          appkey: \\\\\\\"FFFF0N0N00000000AF5C\\\\\\\",\\\\n //          //使用场景标识。它和应用类型标识（appkey字段）一起决定了无痕验证的业务场景与后端对应使用的策略模型。您可以在阿里云验证码控制台的配置管理页签找到对应的scene值，请务必正确填写。\\\\n //          scene: \\\\\\\"nvc_login\\\\\\\",\\\\n //          // 二次验证获取人机信息串，跟随业务请求一起上传至业务服务器，由业务服务器进行验签。\\\\n //          success: function (data) {\\\\n //        \\\\t  sliderCheckPass = true;\\\\n //              if (loginWay == 2) {\\\\n //                  // 短信登录，滑动通过后，只是为了获取短信\\\\n //                  verifyPhoneCode(data);\\\\n //                  clearSlide();//隐藏\\\\n //                  return;\\\\n //              }\\\\n //              // 执行登录逻辑\\\\n //              unifyLoginEnter(data);\\\\n //          },\\\\n //          // 前端二次验证失败时触发该回调参数\\\\n //          fail: function (failCode) {\\\\n //              sliderCheckPass = false;\\\\n //          },\\\\n //          // 前端二次验证加载异常时触发该回调参数。\\\\n //          error: function (errorCode) {\\\\n //              console.log(\\\\\\\"前端二次验证加载异常时\\\\\\\",errorCode)\\\\n //          },\\\\n //        /*  test: module.TEST_NC_PASS  */\\\\n //      });\\\\n // });\\\\n \\\\n\\\\nvar loginWay = 1;//1-帐号密码登录   2-手机号验证码登录   3-手机号密码登录\\\\nvar sceneId = \\\\\\\"1l5vwz7g\\\\\\\";\\\\nvar buttonType = 1;\\\\nvar sliderCheckPass = true;\\\\nvar appearNewNvc = false;// 是否出现过滑动\\\\n$(\\\\\\\".resetBtn\\\\\\\").bind(\\\\\\\"click\\\\\\\", function() {\\\\n\\\\t$(\\\\\\\"#loginForm1\\\\\\\")[0].reset();\\\\n});\\\\n$('#loginClick').bind('click', function() {\\\\n\\\\twindow.location.href = \\\\\\\"html/System/collect.html\\\\\\\";\\\\n})\\\\n$('.nav').bind(\\\\\\\"click\\\\\\\", '.navBtn', function() {\\\\n\\\\t$(this).find('.selectP').addClass('activeImg');\\\\n\\\\t$(this).siblings('div').find('.selectP').siblings('p').addClass('activeImg');\\\\n\\\\tvar dataSrc = $(this).attr('data-src');\\\\n\\\\t$(\\\\\\\".\\\\\\\" + dataSrc).addClass('loginContentActive');\\\\n\\\\tif (dataSrc == 'codeContent') {\\\\n\\\\t\\\\t$(\\\\\\\".nav\\\\\\\").removeClass('navActive');\\\\n\\\\t} else {\\\\n\\\\t\\\\t$(\\\\\\\".nav\\\\\\\").addClass('navActive');\\\\n\\\\t}\\\\n});\\\\n\\\\n\\\\n/*   //换验证码图片\\\\n   function changeImage(){\\\\n       $(\\\\\\\"#checkCodeImg\\\\\\\").attr(\\\\\\\"src\\\\\\\",\\\\\\\"getImage?i=\\\\\\\"+new Date);\\\\n   }*/\\\\n  //切换登录方式（手机号+验证码或者手机号+密码）\\\\n  function swiperPhoneWay() { \\\\n\\\\tif (loginWay == 2) {\\\\n\\\\t\\\\tloginWay = 3\\\\n\\\\t\\\\t$('.one_way').show();\\\\n\\\\t\\\\t$('.two_way').hide();\\\\n\\\\t\\\\t$(\\\\\\\".swiper_oper span\\\\\\\").text(\\\\\\\"手机号+验证码登录\\\\\\\")\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tloginWay = 2\\\\n\\\\t$('.one_way').hide();\\\\n\\\\t$('.two_way').show();\\\\n\\\\t$(\\\\\\\".swiper_oper span\\\\\\\").text(\\\\\\\"手机号+密码登录\\\\\\\");\\\\n\\\\t// 清除状态\\\\n\\\\tclearSlide();\\\\n\\\\treturn;\\\\n}\\\\n //切换登录方式\\\\n function swiperLoginWay(val) { \\\\n\\\\tif (val == 1) {\\\\n\\\\t\\\\t$(\\\\\\\".pwd_login\\\\\\\").addClass('on_way');\\\\n\\\\t\\\\t$(\\\\\\\".phone_login\\\\\\\").removeClass('on_way');\\\\n\\\\t\\\\t$('#generalLogin').show();\\\\n\\\\t\\\\t$('#phoneLogin').hide();\\\\n\\\\t\\\\t$('.swiper_oper').hide();\\\\n\\\\t\\\\tloginWay = 1;\\\\n\\\\t}\\\\n\\\\tif (val == 2) {\\\\n\\\\t\\\\t$(\\\\\\\".pwd_login\\\\\\\").removeClass('on_way');\\\\n\\\\t\\\\t$(\\\\\\\".phone_login\\\\\\\").addClass('on_way');\\\\n\\\\t\\\\t$('#generalLogin').hide();\\\\n\\\\t\\\\t$('#phoneLogin').show();\\\\n\\\\t\\\\t$('.swiper_oper').show();\\\\n\\\\t\\\\t$('.one_way').show();\\\\n\\\\t\\\\t$('.two_way').hide();\\\\n\\\\t\\\\tloginWay = 3\\\\n\\\\t\\\\t$(\\\\\\\"#loginForm1\\\\\\\")[0].reset();\\\\n\\\\t\\\\tif (timerId) {\\\\n\\\\t\\\\t\\\\tclearInterval(timerId)\\\\n\\\\t\\\\t\\\\ttimerId = null\\\\n\\\\t\\\\t\\\\t$('.get_code').text('获取验证码');\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\t// 清除状态\\\\n\\\\tclearSlide();\\\\n}   \\\\n   \\\\n   \\\\n\\\\nfunction showUserPop() { //打开选择帐号弹框\\\\n\\\\t$('.user_code_pop').show();\\\\n}\\\\n\\\\nfunction closeUserPop() { //关闭选择帐号弹框\\\\n\\\\t$('.user_code_pop').hide();\\\\n\\\\trefreshCode();\\\\n}\\\\n\\\\nfunction closesPhoneCode() { //关闭验证码弹框\\\\n\\\\t$('.phone_code_pop').hide();\\\\n}\\\\nlet time = 60;\\\\nlet timerId = null;\\\\n\\\\n\\\\nfunction getPhoneCode() { //获取手机验证码（升级：滑动验证前置）\\\\n    if (timerId) {\\\\n        return;\\\\n    }\\\\n    let loginPhone = document.loginForm.loginPhone.value;\\\\n    if (document.loginForm.loginPhone.value == \\\\\\\"\\\\\\\" && loginWay == 2) {\\\\n        alert(\\\\\\\"请输入手机号！\\\\\\\");\\\\n        document.loginForm.loginPhone.focus();\\\\n        return;\\\\n    }\\\\n    // 手机号规则\\\\n    if(!/^1\\\\\\\\d{10}$/.test(loginPhone)){\\\\n        alert(\\\\\\\"手机号格式有误！\\\\\\\");\\\\n        $(\\\\\\\"#loginPhone\\\\\\\").focus();\\\\n        return;\\\\n    }\\\\n    // 触发隐藏按钮，弹出阿里云验证码（初始化已在页面加载时完成）\\\\n\\\\tbuttonType = 2;\\\\n    document.getElementById('hiddenTrigger').click();\\\\n\\\\n}\\\\n\\\\nvar bindTime = 60;\\\\nvar bindTimerId = 60;\\\\n\\\\n// 绑定手机号中的获取图形验证码\\\\nfunction bindPhoneCountTime() {\\\\n\\\\t// 判断图形验证码是否为空\\\\n\\\\tvar bindVerifyCode = $(\\\\\\\"#bindVerifyCode\\\\\\\").val();\\\\n\\\\tif(!/^\\\\\\\\d{4}$/.test(bindVerifyCode)) {\\\\n\\\\t\\\\talert(\\\\\\\"图形验证码格式不合法\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\t// 手机号校验\\\\n\\\\tvar bindPhone = $(\\\\\\\"#bindPhone\\\\\\\").val();\\\\n\\\\tif(!/^1\\\\\\\\d{10}$/.test(bindPhone)) {\\\\n\\\\t\\\\talert(\\\\\\\"手机号格式不合法\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\t$.get(\\\\\\\"Login.fuiou?action=sendPhoneVerify\\\\\\\",{\\\\\\\"verifyCode\\\\\\\":bindVerifyCode,\\\\\\\"phone\\\\\\\":bindPhone},function(res) {\\\\n\\\\t\\\\talert(res.msg);\\\\n\\\\t\\\\tif(res.code == 0) {\\\\n\\\\t\\\\t\\\\t// 请求后台 disabled\\\\n\\\\t\\\\t\\\\t$('.getVerifyCode').attr(\\\\\\\"disabled\\\\\\\",true);\\\\n            bindTimerId = setInterval(function() {\\\\n\\\\t\\\\t\\\\t\\\\tif (bindTime <= 0) {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\tclearInterval(bindTimerId)\\\\n                    bindTimerId = null\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t$('.getVerifyCode').text('获取验证码');\\\\n                    $('.getVerifyCode').removeAttr(\\\\\\\"disabled\\\\\\\");\\\\n\\\\t\\\\t\\\\t\\\\t\\\\treturn\\\\n\\\\t\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t\\\\t\\\\t$('.getVerifyCode').text((bindTime--) + 's');\\\\n\\\\t\\\\t\\\\t}, 1e3)\\\\n\\\\t\\\\t}else if(res.code = 5556){\\\\n\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t}\\\\n\\\\t});\\\\t\\\\n}\\\\n\\\\n\\\\nfunction countTime() {\\\\n\\\\ttimerId = setInterval(function() {\\\\n\\\\t\\\\tif (time <= 0) {\\\\n\\\\t\\\\t\\\\tclearInterval(timerId)\\\\n\\\\t\\\\t\\\\ttimerId = null\\\\n\\\\t\\\\t\\\\t$('.get_code').text('获取验证码');\\\\n\\\\t\\\\t\\\\treturn\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\t$('.get_code').text(time + 's');\\\\n\\\\t\\\\ttime--\\\\n\\\\t}, 1e3)\\\\n}\\\\n\\\\n// 发送手机短信验证码（返回Promise形式，配合阿里云验证回调）\\\\nfunction verifyPhoneCode(captchaVerifyParam) {\\\\n    return new Promise(function(resolve) {\\\\n        var loginPhone = $(\\\\\\\"#loginPhone\\\\\\\").val();\\\\n        var payload = {\\\\n            action: \\\\\\\"sendPhoneCode\\\\\\\",\\\\n            phone: loginPhone,\\\\n\\\\t\\\\t\\\\tsceneId: sceneId,\\\\n            captchaVerifyParam: captchaVerifyParam ? Base.encode(captchaVerifyParam) : \\\\\\\"\\\\\\\"\\\\n        };\\\\n\\\\n        console.log('[verifyPhoneCode] request start', payload);\\\\n        return $.ajax({\\\\n            url: \\\\\\\"/Login.fuiou\\\\\\\",\\\\n            type: \\\\\\\"POST\\\\\\\",\\\\n            dataType: \\\\\\\"json\\\\\\\",\\\\n            data: payload,\\\\n            success: function(res) {\\\\n                \\\\n                console.log('[verifyPhoneCode] response', res);\\\\n\\\\n                var codeNum = Number(res && res.code);\\\\n                var captchaVerify = String(res && res.code) !== '-1000';\\\\n                var businessVerify = codeNum === 0;\\\\n\\\\n                if (businessVerify) {\\\\n                    time = 60;\\\\n                    countTime();\\\\n                    alert(\\\\\\\"短信验证码发送成功，请注意查看手机短信！\\\\\\\");\\\\n                } else {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\tif (captchaVerify) {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\talert(res && res.msg ? res.msg : '发送短信验证码失败');\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t$(\\\\\\\"#phoneCodeForm1\\\\\\\")[0].reset();\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t}\\\\n                }\\\\n\\\\n                resolve({\\\\n                    captchaResult: captchaVerify,\\\\n                    bizResult: businessVerify\\\\n                });\\\\n            },\\\\n            error: function(xhr, status, err) {\\\\n                console.error('[verifyPhoneCode] error', status, err, xhr && xhr.status, xhr && xhr.responseText);\\\\n                alert('网络异常或服务不可用');\\\\n                resolve({\\\\n                    captchaResult: true,\\\\n                    bizResult: false\\\\n                });\\\\n            },\\\\n            complete: function() {\\\\n                console.log('[verifyPhoneCode] request complete');\\\\n            }\\\\n        });\\\\n    });\\\\n}\\\\n\\\\n// 图形验证码刷新\\\\nfunction refreshCode() {\\\\n\\\\tvar url = \\\\\\\"kaptcha.jpg?d=\\\\\\\"+new Date().getTime();\\\\n            // console.log(document.getElementsByClassName(\\\\\\\"btn_code\\\\\\\")[0].src)\\\\n             $(\\\\\\\".btn_code\\\\\\\").attr(\\\\\\\"src\\\\\\\",url);\\\\n            // 清除验证码的值\\\\n            $(\\\\\\\"#phoneCode\\\\\\\").val(\\\\\\\"\\\\\\\");\\\\n            $(\\\\\\\"#pageCode\\\\\\\").val(\\\\\\\"\\\\\\\");\\\\n            $(\\\\\\\"#pagePhoneCode\\\\\\\").val(\\\\\\\"\\\\\\\");\\\\n            // document.getElementsByClassName(\\\\\\\"btn_code\\\\\\\")[0].src =document.getElementsByClassName(\\\\\\\"btn_code\\\\\\\")[1].src=document.getElementsByClassName(\\\\\\\"btn_code\\\\\\\")[2].src=\\\\\\\"kaptcha.jpg?d=\\\\\\\" + new Date().getTime();\\\\n}\\\\n\\\\n\\\\n//登录，分三种情况登录（滑动验证前置统一入口）\\\\nfunction loginSubmit() {\\\\n    buttonType = 1;\\\\n    document.getElementById('hiddenTrigger').click();\\\\n    return false;\\\\n}\\\\n\\\\n\\\\n// 统一登录入口（Promise 封装，配合阿里云验证码回调）\\\\nfunction unifyLoginEnter(captchaVerifyParam) {\\\\n    return new Promise(function(resolve) {\\\\n        let loginId = $.trim(document.loginForm.loginId.value);\\\\n        let loginPwd = $.trim(document.loginForm.loginPwd.value);\\\\n        if (document.loginForm.loginId.value == \\\\\\\"\\\\\\\" && loginWay == 1) {\\\\n            alert(\\\\\\\"请输入手机号/帐号！\\\\\\\");\\\\n            document.loginForm.loginId.focus();\\\\n            return resolve({ captchaResult: true, bizResult: false });\\\\n        }\\\\n        if (document.loginForm.loginPwd.value == \\\\\\\"\\\\\\\" && loginWay == 1) {\\\\n            alert(\\\\\\\"请输入密码！\\\\\\\");\\\\n            document.loginForm.loginPwd.focus();\\\\n            return resolve({ captchaResult: true, bizResult: false });\\\\n        }\\\\n        let loginPhone = document.loginForm.loginPhone.value;\\\\n        let loginCode = document.loginForm.loginCode.value;\\\\n        let loginPhonePwd = $(\\\\\\\"#loginPhonePwd\\\\\\\").val();\\\\n        if ((loginWay == 2 || loginWay == 3) && !/1\\\\\\\\d{10}$/.test(loginPhone)) {\\\\n            alert(\\\\\\\"手机号格式不正确！\\\\\\\");\\\\n            document.loginForm.loginPhone.focus();\\\\n            return resolve({ captchaResult: true, bizResult: false });\\\\n        }\\\\n        if (loginWay == 3 && loginPhonePwd.length < 4) {\\\\n            alert(\\\\\\\"密码格式不正确！\\\\\\\");\\\\n            document.loginForm.loginPhonePwd.focus();\\\\n            return resolve({ captchaResult: true, bizResult: false });\\\\n        }\\\\n        if(loginWay == 2 && !/^\\\\\\\\d{6}/.test(loginCode)){\\\\n            alert(\\\\\\\"手机验证码不正确，验证码为6位数的纯数字！\\\\\\\");\\\\n            document.loginForm.loginCode.focus();\\\\n            return resolve({ captchaResult: true, bizResult: false });\\\\n        }\\\\n        var oldLoginId = $(\\\\\\\"#loginId\\\\\\\").val();\\\\n        $(\\\\\\\"#loginId\\\\\\\").val($.trim(oldLoginId));\\\\n        if (localStorage.getItem('indexDl')) {\\\\n            localStorage.removeItem('indexDl');\\\\n            localStorage.removeItem('ddIndex');\\\\n            localStorage.removeItem('irameSrc');\\\\n        }\\\\n        loginPwd = md5(loginPwd);\\\\n        let params = {\\\\n            \\\\\\\"action\\\\\\\" : \\\\\\\"checkLoginFirst\\\\\\\",\\\\n            \\\\\\\"loginWay\\\\\\\":loginWay,\\\\n            \\\\\\\"smsCode\\\\\\\" : loginCode,\\\\n            \\\\\\\"phone\\\\\\\" : loginPhone,\\\\n            \\\\\\\"loginId\\\\\\\" : loginId,\\\\n            \\\\\\\"loginPwd\\\\\\\": loginPwd,\\\\n            \\\\\\\"captchaVerifyParam\\\\\\\": captchaVerifyParam ? Base.encode(captchaVerifyParam) : \\\\\\\"\\\\\\\",\\\\n\\\\t\\\\t\\\\t\\\\\\\"sceneId\\\\\\\": sceneId,\\\\n            \\\\\\\"phonePwd\\\\\\\": loginPhonePwd\\\\n        };\\\\n\\\\n        $('.loading_pop').show();\\\\n        console.log('[unifyLoginEnter] request start', params);\\\\n        return $.ajax({\\\\n            url: \\\\\\\"/Login.fuiou\\\\\\\",\\\\n            type: \\\\\\\"POST\\\\\\\",\\\\n            dataType: \\\\\\\"json\\\\\\\",\\\\n            data: params,\\\\n            success: function(res) {\\\\n                $('.loading_pop').hide();\\\\n                console.log('[unifyLoginEnter] response', res);\\\\n                let codeNum = Number(res && res.code);\\\\n                let captchaVerify = String(res && res.code) !== '-1000';\\\\n                let businessVerify = codeNum === 0;\\\\n\\\\n                if(res.code == 0 && (loginWay == 2 || loginWay == 3)) {\\\\n                    clearSlide();\\\\n                    if(res.count == 1) {\\\\n                        commonLogin(res,res.data[0].bindLoginId,\\\\\\\"\\\\\\\");\\\\n                    }else {\\\\n                        phoneMutiLogin(res);\\\\n                    }\\\\n                }else if (res.code == 0 && loginWay == 1) {\\\\n                    commonLogin(res,loginId,loginPwd);\\\\n                }else if(res.code == 5040){\\\\n                    $(\\\\\\\"#bindPhone\\\\\\\").val(loginPhone);\\\\n                    confirmFn(\\\\\\\"该手机号未绑定任何账号，是否需要绑定?\\\\\\\",function(){bindPhone_show()},function(){\\\\n                        if(appearNewNvc) {\\\\n                            getNC();\\\\n                        }\\\\n                    },\\\\\\\"是\\\\\\\",\\\\\\\"否\\\\\\\");\\\\n                }else {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\tif(captchaVerify){\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\talert(res.msg);\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\tclick = 0;\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t}\\\\n                }\\\\n\\\\n                resolve({\\\\n                    captchaResult: captchaVerify,\\\\n                    bizResult: businessVerify\\\\n                });\\\\n            },\\\\n            error: function(xhr, status, err) {\\\\n                console.error('[unifyLoginEnter] error', status, err, xhr && xhr.status, xhr && xhr.responseText);\\\\n                $('.loading_pop').hide();\\\\n                alert('网络异常或服务不可用');\\\\n                resolve({\\\\n                    captchaResult: true,\\\\n                    bizResult: false\\\\n                });\\\\n            }\\\\n        });\\\\n    });\\\\n}\\\\n\\\\n\\\\n\\\\nvar click = 0;\\\\ndocument.onkeydown = function(e) {\\\\n\\\\tif (!e) e = window.event; //火狐中是 window.event\\\\n\\\\tif ((e.keyCode || e.which) == 13 && click == 0) {\\\\n\\\\t\\\\t//login();\\\\n\\\\t\\\\tclick = 1;\\\\n\\\\t\\\\tloginSubmit();\\\\n\\\\t}\\\\n};\\\\n\\\\n    // 结果有多个的\\\\n    function phoneMutiLogin(res) {\\\\n    \\\\t//拼装html\\\\n\\\\t\\\\tlet userInfHtml = \\\\\\\"\\\\\\\";\\\\n\\\\t\\\\t$.each(res.data,function(index,item){\\\\n\\\\t\\\\t\\\\tuserInfHtml += '<div class=\\\\\\\"user_view\\\\\\\">' +\\\\n\\\\t\\\\t\\\\t\\\\t  \\\\t\\\\t\\\\t\\\\t'<img src=\\\\\\\"/page/assets/images/login/swiper.png\\\\\\\">'+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t '<div class=\\\\\\\"\\\\\\\">'+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t          \\\\t'<p>'+item.bindLoginId+'</p>'+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t  \\\\t'<p>'+item.bindUserName+'</p>'+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t             '</div>'+\\\\n\\\\t\\\\t\\\\t             '</div>';\\\\n\\\\t\\\\t});\\\\n\\\\t\\\\t$(\\\\\\\".user_info\\\\\\\").append(userInfHtml);\\\\n\\\\t\\\\tshowUserPop();\\\\n\\\\n\\\\t\\\\t// 获取点击后选择的账号\\\\n\\\\t\\\\t$(\\\\\\\".user_view\\\\\\\").on(\\\\\\\"click\\\\\\\",function() {\\\\n\\\\t\\\\t\\\\tlet loginId = $(this).find(\\\\\\\"p\\\\\\\").eq(0).text();\\\\n\\\\t\\\\t\\\\tlet selectLoginParams = {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\\\\"action\\\\\\\" : \\\\\\\"login\\\\\\\",\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginWay\\\\\\\":loginWay,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\\\\"token\\\\\\\": res.msg,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginId\\\\\\\": loginId,\\\\n\\\\t\\\\t\\\\t\\\\t};\\\\n\\\\t\\\\t\\\\tcommonLogin(res,loginId,\\\\\\\"\\\\\\\");\\\\n\\\\t\\\\t});\\\\n    }\\\\n\\\\n    // 公共模块登录\\\\n    function commonLogin(res,loginId,loginPwd) {\\\\n    \\\\t$('.loading_pop').show();\\\\n    \\\\t// 再请求一次\\\\n    \\\\t$.post(\\\\\\\"/Login.fuiou?action=checkPwd\\\\\\\",{\\\\\\\"loginId\\\\\\\":loginId,\\\\\\\"loginPwd\\\\\\\":loginPwd,\\\\\\\"loginWay\\\\\\\":loginWay},function(checkRes){\\\\n    \\\\t\\\\t$('.loading_pop').hide();\\\\n    \\\\t\\\\t//console.log(checkRes);\\\\n    \\\\t\\\\tif(checkRes.code == 0) {\\\\n    \\\\t\\\\t\\\\t// 成功\\\\n    \\\\t\\\\t\\\\taccountLogin(res.msg,loginId,loginPwd);\\\\n    \\\\t\\\\t}else if(checkRes.code == 3) {\\\\n    \\\\t\\\\t\\\\tconfirmFn(\\\\\\\"当前账号超过六个月未修改密码，风险较高，为保证您的账号安全，请及时修改登录密码\\\\\\\",function(){updPwd();},function(){\\\\n    \\\\t\\\\t\\\\t\\\\t// 取消了\\\\n        \\\\t\\\\t   accountLogin(res.msg,loginId,loginPwd);\\\\n    \\\\t\\\\t\\\\t});\\\\n    \\\\t\\\\t}else if(appearNewNvc && checkRes.code == 9998){\\\\n    \\\\t\\\\t\\\\talert(checkRes.errorMessage);\\\\n    \\\\t\\\\t\\\\tclearSlide();\\\\n    \\\\t\\\\t}else {\\\\n    \\\\t\\\\t\\\\talert(checkRes.errorMessage);\\\\n    \\\\t\\\\t\\\\t//refreshCode();\\\\n    \\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n    \\\\t\\\\t}\\\\n    \\\\t});\\\\n    };\\\\n    \\\\n // 账号登录\\\\nfunction accountLogin(token,loginId,loginPwd) {\\\\n\\\\t\\\\t$('.loading_pop').show();\\\\n\\\\t\\\\tlet accPwdPass = {\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"action\\\\\\\" : \\\\\\\"login\\\\\\\",\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginWay\\\\\\\":loginWay,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"token\\\\\\\": token,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginId\\\\\\\": loginId,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginPwd\\\\\\\":loginPwd,\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"loginPhone\\\\\\\": $(\\\\\\\"#loginPhone\\\\\\\").val()\\\\n\\\\t\\\\t\\\\t};\\\\n\\\\t\\\\t//登录接口，账号密码登录\\\\n\\\\t\\\\t$.post(\\\\\\\"/Login.fuiou\\\\\\\",accPwdPass,function(res){\\\\n\\\\t\\\\t\\\\t//refreshCode();\\\\n\\\\t\\\\t\\\\tif(res.code == 0) {\\\\n\\\\t\\\\t\\\\t\\\\twindow.location.href = res.msg;\\\\n\\\\t\\\\t\\\\t}else {\\\\n\\\\t\\\\t\\\\t\\\\talert(res.msg);\\\\n\\\\t\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t});\\\\n} \\\\n    \\\\n//出现滑动验证\\\\nfunction getNC() {\\\\n\\\\t$(\\\\\\\".slider_pop_div\\\\\\\").css('display', 'flex');\\\\n    $(\\\\\\\"#slider_nc\\\\\\\").children().remove();\\\\n    sliderCheckPass = false;\\\\n    appearNewNvc = true;\\\\n    var ncoption = {\\\\n        // 声明滑动验证需要渲染的目标ID。\\\\n        renderTo: \\\\\\\"slider_nc\\\\\\\",\\\\n        // 二次验证文案配置\\\\n        upLang: {\\\\n            'nc': {\\\\n                //加载状态提示。\\\\n                'LOADING': \\\\\\\"加载中...\\\\\\\",\\\\n                //等待滑动状态提示。\\\\n                'SLIDE': \\\\\\\"请向右滑动验证\\\\\\\",\\\\n                //验证通过状态提示。\\\\n                'SUCCESS': \\\\\\\"验证通过\\\\\\\",\\\\n                //验证失败触发拦截状态提示。\\\\n                'ERROR': \\\\\\\"非常抱歉，网络出错了...\\\\\\\",\\\\n                //验证失败触发拦截状态提示。\\\\n                'FAIL': \\\\\\\"验证失败，请重试\\\\\\\"\\\\n            }\\\\n        }\\\\n    }\\\\n    // 唤醒二次验证（滑动验证码）\\\\n    window.nvc.getNC(ncoption);\\\\n}\\\\n \\\\n // 清除滑块\\\\nfunction clearSlide() {\\\\n    // if(sliderCheckPass == false) {\\\\n    // \\\\tgetNC();\\\\n    // }\\\\n    //if(sliderCheckPass == true) {\\\\n    \\\\t //$(\\\\\\\".from_nc\\\\\\\"+loginWay).css('display', 'none');\\\\n    \\\\t $(\\\\\\\".slider_pop_div\\\\\\\").css('display', 'none');\\\\n    \\\\t $(\\\\\\\"#slider_nc\\\\\\\").children().remove();\\\\n   // }\\\\n}\\\\n \\\\n \\\\n//-------------------------------------------登录完成------------------------------------------------------\\\\n//修改密码\\\\nfunction updPwd() {\\\\n\\\\tvar loginId = $(\\\\\\\"#loginId\\\\\\\").val();\\\\n\\\\t$.mdfAlert({\\\\n\\\\t\\\\t'loginId': loginId\\\\n\\\\t}, mdfFn);\\\\n}\\\\n\\\\n//修改密码弹框\\\\n$.mdfAlert = function(opt, mdfFn) {\\\\n\\\\tvar _this = document.createElement(\\\\\\\"div\\\\\\\");\\\\n\\\\t_this.id = \\\\\\\"addAlert\\\\\\\";\\\\n\\\\t_this.innerHTML = '<div class=\\\\\\\"conent\\\\\\\">' +\\\\n\\\\t\\\\t'<form action=\\\\\\\"\\\\\\\" method=\\\\\\\"post\\\\\\\">' +\\\\n\\\\t\\\\t'<h2>修改密码</h2>' +\\\\n\\\\t\\\\t'<div class=\\\\\\\"cont\\\\\\\">' +\\\\n\\\\t\\\\t'<div class=\\\\\\\"padding-bottom-10\\\\\\\">' +\\\\n\\\\t\\\\t'<label>旧密码：</label><input class=\\\\\\\"inp\\\\\\\" type=\\\\\\\"password\\\\\\\" autocomplete=\\\\\\\"off\\\\\\\" placeholder=\\\\\\\"\\\\\\\" id=\\\\\\\"oldPwd\\\\\\\" />' +\\\\n\\\\t\\\\t'</div>' +\\\\n\\\\t\\\\t'<div class=\\\\\\\"padding-bottom-10\\\\\\\">' +\\\\n\\\\t\\\\t'<label>新密码：</label><input class=\\\\\\\"inp\\\\\\\" type=\\\\\\\"password\\\\\\\" autocomplete=\\\\\\\"new-password\\\\\\\" placeholder=\\\\\\\"\\\\\\\" id=\\\\\\\"newPwd\\\\\\\" />' +\\\\n\\\\t\\\\t'</div>' +\\\\n\\\\t\\\\t'<div class=\\\\\\\"padding-bottom-10\\\\\\\">' +\\\\n\\\\t\\\\t'<label>确认新密码：</label><input class=\\\\\\\"inp\\\\\\\" type=\\\\\\\"password\\\\\\\" autocomplete=\\\\\\\"new-password\\\\\\\" placeholder=\\\\\\\"\\\\\\\" id=\\\\\\\"againPwd\\\\\\\" />' +\\\\n\\\\t\\\\t'</div>' +\\\\n\\\\t\\\\t'</div>' +\\\\n\\\\t\\\\t'<div class=\\\\\\\"b-footer clearfix\\\\\\\"><a href=\\\\\\\"javascript:;\\\\\\\" class=\\\\\\\"btn btn-ensure\\\\\\\">确定</a><a href=\\\\\\\"javascript:;\\\\\\\" class=\\\\\\\"btn btn-del\\\\\\\">取消</a></div>' +\\\\n\\\\t\\\\t'</form>' +\\\\n\\\\t\\\\t'</div>'\\\\n\\\\t$(\\\\\\\"body\\\\\\\").append(_this);\\\\n\\\\tvar cont = $(_this).find(\\\\\\\".conent\\\\\\\");\\\\n\\\\tcont.css({\\\\n\\\\t\\\\tmarginTop: -cont.outerHeight(true) / 2\\\\n\\\\t});\\\\n\\\\t$(_this).find('.btn-ensure')[0].onclick = function() {\\\\n\\\\t\\\\tif (mdfFn && typeof mdfFn == 'function') {\\\\n\\\\t\\\\t\\\\tmdfFn(opt);\\\\n\\\\t\\\\t}\\\\n\\\\t}\\\\n\\\\t$(_this).find('.btn-del')[0].onclick = function() {\\\\n\\\\t\\\\t$(_this).remove();\\\\n\\\\t}\\\\n};\\\\n\\\\n//弹窗提示  当取消预约复投时，则处理弹窗操作\\\\nvar confirmFn = function(content,callback,cancel,confirmBtn,cancelBtn){ \\\\n\\\\tif(!confirmBtn) {\\\\n\\\\t\\\\tconfirmBtn = \\\\\\\"去修改\\\\\\\";\\\\n\\\\t}\\\\n\\\\tif(!cancelBtn) {\\\\n\\\\t\\\\tcancelBtn = \\\\\\\"我知道了\\\\\\\";\\\\n\\\\t}\\\\n\\\\tvar popstr=\\\\\\\"<div class='TipsBox'>\\\\\\\"+\\\\n\\\\t\\\\t\\\\\\\"<div class='TipsCon'>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\\\\"<h3>提示</h3>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\\\\"<p>\\\\\\\"+content+\\\\\\\"</p>\\\\\\\"+\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\t\\\\\\\"<div class='btn_alist'>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"<a href='javascript:;' name='next_to' style='background:#5192ED; color:#fff'>\\\\\\\"+confirmBtn+\\\\\\\"</a>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\t\\\\\\\"<a href='javascript:;' name='cancel' style='background:#eee; color:#666;'>\\\\\\\"+cancelBtn+\\\\\\\"</a>\\\\\\\"+\\\\n\\\\t\\\\t\\\\t\\\\\\\"</div>\\\\\\\"+\\\\t\\\\t\\\\t\\\\n\\\\t\\\\t\\\\\\\"</div>\\\\\\\"+\\\\n\\\\t\\\\\\\"</div>\\\\\\\";\\\\t\\\\n\\\\tif($('.TipsBox').length>0){$('.TipsBox').remove();}\\\\t\\\\t\\\\t\\\\n\\\\t$(\\\\\\\"body\\\\\\\").append(popstr);\\\\t\\\\n\\\\t$(\\\\\\\"[name='cancel']\\\\\\\").on('click',function(){ //关闭弹窗提示\\\\n\\\\t\\\\t$(\\\\\\\".TipsBox\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"none\\\\\\\");\\\\n\\\\t\\\\tif(cancel){cancel();}\\\\t\\\\n\\\\t});\\\\n\\\\t$(\\\\\\\"[name='next_to']\\\\\\\").on('click',function(){ //确定继续操作\\\\n\\\\t\\\\t$(\\\\\\\".TipsBox\\\\\\\").css(\\\\\\\"display\\\\\\\",\\\\\\\"none\\\\\\\");\\\\n\\\\t\\\\tif(callback){callback();}\\\\t\\\\n\\\\t});\\\\n } \\\\n\\\\n\\\\nfunction mdfFn(opt) {\\\\n\\\\tvar loginId = $(\\\\\\\"#loginId\\\\\\\").val();\\\\n\\\\tvar oldPwd = $(\\\\\\\"#oldPwd\\\\\\\").val();\\\\n\\\\tvar newPwd = $(\\\\\\\"#newPwd\\\\\\\").val();\\\\n\\\\tvar againPwd = $(\\\\\\\"#againPwd\\\\\\\").val();\\\\n\\\\n\\\\tif (oldPwd == \\\\\\\"\\\\\\\" || newPwd == \\\\\\\"\\\\\\\" || againPwd == \\\\\\\"\\\\\\\") {\\\\n\\\\t\\\\talert(\\\\\\\"旧密码，新密码，再次输入新密码不能为空！\\\\\\\");\\\\n\\\\t\\\\tdocument.all.oldPwd.focus();\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\tif (newPwd != againPwd) {\\\\n\\\\t\\\\talert(\\\\\\\"两次输入的新密码不一致！\\\\\\\");\\\\n\\\\t\\\\tdocument.all.newPwd.focus();\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\tif (!(function() {\\\\n\\\\t        var pwd = $(\\\\\\\"#newPwd\\\\\\\").val();\\\\n    \\\\t\\\\tvar reg1 = /^\\\\\\\\w{8}\\\\\\\\w*$/;\\\\n    \\\\t\\\\tvar reg2 = /^\\\\\\\\w*[a-zA-Z]+[0-9]+\\\\\\\\w*|\\\\\\\\w*[0-9]+[a-zA-Z]+\\\\\\\\w*$/;\\\\n    \\\\t\\\\tif (!reg1.test(pwd) || !reg2.test(pwd)){\\\\n    \\\\t\\\\t      alert(\\\\\\\"登录密码至少为8位，且至少包含一位数字和字母\\\\\\\");\\\\n                      return false;\\\\n    \\\\t\\\\t}\\\\n\\\\t    \\\\t\\\\t/* var reg1 = /^\\\\\\\\w+$/,reg2 = /^\\\\\\\\w{8}\\\\\\\\w*$/,reg3 = /^\\\\\\\\w*[a-zA-Z]+[0-9]+\\\\\\\\w*|\\\\\\\\w*[0-9]+[a-zA-Z]+\\\\\\\\w*$/;\\\\n\\\\t    \\\\t\\\\tvar arr = [[reg1,\\\\\\\"新密码只允许字母或数字\\\\\\\"],[reg2,\\\\\\\"新密码至少为8位\\\\\\\"],[reg3,\\\\\\\"新密码至少包含一位数字和字母\\\\\\\"]];\\\\n    \\\\t\\\\t\\\\n\\\\t    \\\\t\\\\tfor(var i = 0; i < arr.length; i++){\\\\n\\\\t    \\\\t\\\\t\\\\tif (!arr[i][0].test(pwd)){\\\\n\\\\t    \\\\t\\\\t\\\\t\\\\talert(arr[i][1]);\\\\n\\\\t    \\\\t\\\\t\\\\t\\\\treturn false;\\\\n\\\\t    \\\\t\\\\t\\\\t}\\\\n\\\\t    \\\\t\\\\t} */\\\\n\\\\t\\\\treturn true;\\\\n\\\\t\\\\t})()) {\\\\n\\\\t\\\\treturn false;\\\\n\\\\t}\\\\n\\\\t$('.loading_pop').show();\\\\n\\\\t$.ajax({\\\\n\\\\t\\\\turl: \\\\\\\"Login.fuiou\\\\\\\",\\\\n\\\\t\\\\ttype: \\\\\\\"post\\\\\\\",\\\\n\\\\t\\\\tdataType: \\\\\\\"json\\\\\\\",\\\\n\\\\t\\\\tdata: {\\\\n\\\\t\\\\t\\\\taction: \\\\\\\"mdyPwd\\\\\\\",\\\\n\\\\t\\\\t\\\\tloginId: loginId,\\\\n\\\\t\\\\t\\\\toldPwd: oldPwd,\\\\n\\\\t\\\\t\\\\tnewPwd: newPwd\\\\n\\\\t\\\\t},\\\\n\\\\t\\\\tsuccess: function(data) {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t\\\\trefreshCode();\\\\n\\\\t\\\\t\\\\talert(data.msg);\\\\n\\\\t\\\\t\\\\tif (data.code == '0') {\\\\n\\\\t\\\\t\\\\t\\\\t$(\\\\\\\"#addAlert\\\\\\\").remove();\\\\n\\\\t\\\\t\\\\t\\\\t// 成功后，刷新该页面self.location.replace(location.href);\\\\n\\\\t\\\\t\\\\t}\\\\n\\\\t\\\\t}\\\\n\\\\t\\\\t,error:function() {\\\\n\\\\t\\\\t\\\\t$('.loading_pop').hide();\\\\n\\\\t\\\\t}\\\\n\\\\t});\\\\n\\\\n};\\\\n\\\\t\\\\t\\\\t\\\\n$(\\\\\\\"#togglePassword\\\\\\\").click(function(){\\\\n\\\\tif($(this).hasClass(\\\\\\\"on\\\\\\\")){\\\\n\\\\t\\\\t$(this).removeClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"password\\\\\\\");\\\\n\\\\t}else{\\\\n\\\\t\\\\t$(this).addClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"text\\\\\\\");\\\\n\\\\t}\\\\n});\\\\n\\\\n$(\\\\\\\"#togglePhonePassword\\\\\\\").click(function(){\\\\n\\\\tif($(this).hasClass(\\\\\\\"on\\\\\\\")){\\\\n\\\\t\\\\t$(this).removeClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPhonePwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"password\\\\\\\");\\\\n\\\\t}else{\\\\n\\\\t\\\\t$(this).addClass(\\\\\\\"on\\\\\\\")\\\\n\\\\t\\\\tdocument.getElementById(\\\\\\\"loginPhonePwd\\\\\\\").setAttribute(\\\\\\\"type\\\\\\\",\\\\\\\"text\\\\\\\");\\\\n\\\\t}\\\\n});\\\\n\\\\n// 手机号绑定确定提交\\\\nfunction bindPhone_submit() {\\\\n\\\\tvar sysLoginId = $(\\\\\\\"#sysLoginId\\\\\\\").val();\\\\n\\\\tif(!sysLoginId) {\\\\n\\\\t\\\\talert(\\\\\\\"系统账号不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar sysLoginIdPwd = $(\\\\\\\"#sysLoginIdPwd\\\\\\\").val();\\\\n\\\\tif(!sysLoginIdPwd) {\\\\n\\\\t\\\\talert(\\\\\\\"系统账号密码不能为空\\\\\\\");\\\\n\\\\t\\\\treturn;\\\\n\\\\t}\\\\n\\\\tvar bindPhone = $(\\\\\\\"#bindPhone\\\\\\\").val();\\\\n\\\\tif(!sysL